---
/** Gate for a locked project. The write-up ships as ciphertext in
    /public/locked/<slug>.json (written by `npm run encrypt`) and is decrypted
    in the reader's browser — the passphrase never reaches the server. */

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const fieldId = `pw-${slug}`;
---

<section class="lock" data-slug={slug} aria-live="polite" data-reveal style="--reveal-step: 2">
  <div class="gate">
    <h2>Locked content</h2>
    <p>
      The content here is encrypted. Enter the passphrase I shared with you to decrypt it and continue reading. Thank you!
    </p>

    <form novalidate>
      <label class="visually-hidden" for={fieldId}>Passphrase</label>
      <input
        id={fieldId}
        name="password"
        type="password"
        placeholder="Passphrase"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      />
      <button type="submit">Unlock</button>
    </form>

    <p role="alert" hidden>That passphrase didn't work. Check again.</p>
  </div>

  <article class="prose" hidden></article>
</section>

<style>
  .lock {
    border-block-start: 1px dashed var(--ink);
    padding-block-start: var(--space-lg);
    margin-block: var(--space-lg) var(--space-sm);
  }

  h2 {
    margin-block-end: var(--space-sm);
  }

  form {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-md);
  }

  input,
  button {
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    min-height: 3rem;
  }

  input {
    min-width: 0;
    flex: 0 1 20rem;
    font-size: 0.9375em;
    color: var(--ink);
    background-color: var(--paper);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    transition: border-color var(--dur-fast) var(--ease);
  }

  input:hover {
    border-color: var(--ink-faint);
  }

  input:focus-visible {
    border-color: var(--ink);
  }

  button {
    font-size: var(--step--1);
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    transition: background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-micro) var(--ease);
  }

  button:hover {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }

  /* Press feedback: small enough to read as give, not as a bounce. */

  button:active {
    transform: scale(0.98);
  }

  /* Key derivation runs for a few hundred milliseconds; the button breathes so
     the wait reads as work rather than a dead press. */

  button[data-busy] {
    animation: lock-busy 1.1s var(--ease) infinite;
  }

  @keyframes lock-busy {
    50% {
      opacity: 0.6;
    }
  }

  [role='alert'] {
    font-weight: var(--weight-medium);
    margin-block-start: var(--space-md);
    color: var(--error);
  }

  /* The refusal fades in rather than snapping, so a re-read of the same message
     after a second attempt still registers as a new answer. */

  [role='alert']:not([hidden]) {
    animation: lock-error-in var(--dur-fast) var(--ease) backwards;
  }

  @keyframes lock-error-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  /* Unlocking: the gate steps aside, then the write-up takes its place. Both
     halves are short — this is a hand-off, not a curtain. */

  .gate.is-leaving {
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  /* Opacity only: the write-up arrives while the page is scrolling to it, and a
     transform here would offset that scroll target. */

  .prose.is-entering {
    animation: lock-content-in var(--dur) var(--ease) backwards;
  }

  @keyframes lock-content-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [role='alert']:not([hidden]),
    .prose.is-entering,
    button[data-busy] {
      animation: none;
    }

    .gate.is-leaving {
      transition: none;
    }
  }
</style>

<script>
  import { marked } from 'marked';
  import { withBase } from '../lib/base';

  /** PBKDF2 + AES-GCM; mirrors scripts/encrypt-projects.mjs. */
  interface LockedPayload {
    iter: number;
    salt: string;
    iv: string;
    ct: string;
  }

  const fromB64 = (b64: string): Uint8Array<ArrayBuffer> => {
    const bin = atob(b64);
    const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  };

  const utf8 = (s: string): Uint8Array<ArrayBuffer> => {
    const encoded = new TextEncoder().encode(s);
    const out = new Uint8Array(encoded.length);
    out.set(encoded);
    return out;
  };

  async function decrypt(payload: LockedPayload, password: string): Promise<string> {
    const baseKey = await crypto.subtle.importKey('raw', utf8(password), 'PBKDF2', false, [
      'deriveKey',
    ]);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: fromB64(payload.salt), iterations: payload.iter, hash: 'SHA-256' },
      baseKey,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt']
    );
    const plain = await crypto.subtle.decrypt(
      { name: 'AES-GCM', iv: fromB64(payload.iv) },
      key,
      fromB64(payload.ct)
    );
    return new TextDecoder().decode(plain);
  }

  const root = document.querySelector<HTMLElement>('.lock');
  if (root) {
    const slug = root.dataset.slug!;
    const gate = root.querySelector<HTMLElement>('.gate')!;
    const form = root.querySelector<HTMLFormElement>('form')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const error = root.querySelector<HTMLElement>('[role="alert"]')!;
    const content = root.querySelector<HTMLElement>('article')!;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    /** The gate's exit, read off the motion tokens so the two stay in step. */
    const exit = parseFloat(getComputedStyle(root).getPropertyValue('--dur-fast')) || 167;
    let payload: Promise<LockedPayload> | null = null;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      const password = input.value.trim();
      if (!password) return;

      // Deriving the key takes a beat, so the button says so while it works.
      button.textContent = 'Unlocking…';
      button.dataset.busy = '';
      try {
        payload ??= fetch(withBase(`/locked/${slug}.json`), { cache: 'no-store' }).then((res) => {
          if (!res.ok) throw new Error(`No locked content for "${slug}".`);
          return res.json() as Promise<LockedPayload>;
        });
        content.innerHTML = await marked.parse(await decrypt(await payload, password));

        // Hand the section over from the gate to the decrypted write-up.
        if (!reduce.matches) {
          gate.classList.add('is-leaving');
          await new Promise((resolve) => setTimeout(resolve, exit));
        }
        gate.hidden = true;
        gate.classList.remove('is-leaving');
        content.hidden = false;
        content.classList.add('is-entering');
        content.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch {
        payload = null;
        error.hidden = false;
        input.value = '';
        input.focus();
      } finally {
        button.textContent = 'Unlock';
        delete button.dataset.busy;
      }
    });
  }
</script>
