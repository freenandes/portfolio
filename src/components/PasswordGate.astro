---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{/* The reveal delay picks up where the article's own cascade leaves off. */}
<section class="lock" data-slug={slug} aria-live="polite" data-reveal style="--reveal-delay: 140ms;">
  <div class="lock__panel" data-lock-form>
    <h2 class="lock__title">Locked content</h2>
    <p class="lock__copy">
      The content here is encrypted. Enter the passphrase I shared with you to decrypt it and continue reading. Thank you!
    </p>

    <form class="lock__form" data-lock-submit novalidate>
      <label class="visually-hidden" for={`pw-${slug}`}>Passphrase</label>
      <input
        id={`pw-${slug}`}
        name="password"
        type="password"
        class="input__box"
        placeholder="Passphrase"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      />
      <button type="submit" class="button__pad" data-lock-submit-button>
        <span data-btn-label>Unlock</span>
      </button>
    </form>

    <p class="lock__error" data-lock-error role="alert" hidden>
      That passphrase didn't work. Check again.
    </p>
  </div>

  <article class="prose lock__content" data-lock-content hidden></article>
</section>

<script>
  import { fetchPayload, decryptMarkdown } from '../lib/decrypt';
  import { marked } from 'marked';

  const root = document.querySelector<HTMLElement>('.lock');
  if (root) {
    const slug = root.dataset.slug!;
    const form = root.querySelector<HTMLFormElement>('[data-lock-submit]')!;
    const panel = root.querySelector<HTMLElement>('[data-lock-form]')!;
    const input = root.querySelector<HTMLInputElement>('input[name="password"]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-lock-error]')!;
    const content = root.querySelector<HTMLElement>('[data-lock-content]')!;
    const button = root.querySelector<HTMLElement>('[data-lock-submit-button]')!;
    const btnLabel = root.querySelector<HTMLElement>('[data-btn-label]')!;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    /** The gate's exit, read off the motion tokens so the two stay in step. */
    const EXIT =
      parseFloat(getComputedStyle(root).getPropertyValue('--dur-fast')) || 167;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    let payloadPromise: ReturnType<typeof fetchPayload> | null = null;

    /** Hands the section over from the gate to the decrypted write-up. */
    async function showContent(html: string) {
      content.innerHTML = html;
      if (!reduce.matches) {
        panel.classList.add('is-leaving');
        await wait(EXIT);
      }
      panel.hidden = true;
      panel.classList.remove('is-leaving');
      content.hidden = false;
      content.classList.add('is-entering');
      content.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const password = input.value.trim();
      if (!password) return;

      // Deriving the key takes a beat, so the button says so while it works.
      btnLabel.textContent = 'Unlocking…';
      button.dataset.busy = '';
      try {
        payloadPromise ??= fetchPayload(slug);
        const payload = await payloadPromise;
        const markdown = await decryptMarkdown(payload, password);
        await showContent(await marked.parse(markdown));
      } catch {
        payloadPromise = null;
        errorEl.hidden = false;
        input.value = '';
        input.focus();
      } finally {
        btnLabel.textContent = 'Unlock';
        delete button.dataset.busy;
      }
    });
  }
</script>

<style>
  .lock {
    border-block-start: 1px dashed var(--ink);
    padding-block-start: var(--space-lg);
    margin-block-start: var(--space-lg);
    margin-block-end: var(--space-sm);
  }

  .lock__title {
    font-size: var(--step-2);
    margin-block-end: var(--space-sm);
  }

  .lock__form {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-block-start: var(--space-md);
    flex-wrap: wrap;
  }

  .input__box {
    min-width: 0;
    flex: 0 1 20rem;
  }

  .lock__error {
    font-weight: var(--weight-medium);
    margin-block-start: var(--space-md);
    color: var(--error);
  }

  /* The refusal fades in rather than snapping, so a re-read of the same message
     after a second attempt still registers as a new answer. */

  .lock__error:not([hidden]) {
    animation: lock-error-in var(--dur-fast) var(--ease) backwards;
  }

  @keyframes lock-error-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  /* Unlocking: the gate steps aside, then the write-up takes its place. Both
     halves are short — this is a hand-off, not a curtain. */

  .lock__panel.is-leaving {
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .lock__content.is-entering {
    animation: lock-content-in var(--dur) var(--ease) backwards;
  }

  /* Opacity only: the write-up arrives while the page is scrolling to it, and a
     transform here would offset that scroll target. */

  @keyframes lock-content-in {
    from {
      opacity: 0;
    }
  }

  /* Key derivation runs for a few hundred milliseconds; the button breathes so
     the wait reads as work rather than a dead press. */

  .button__pad[data-busy] {
    animation: lock-busy 1.1s var(--ease) infinite;
  }

  @keyframes lock-busy {
    50% {
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lock__error:not([hidden]),
    .lock__content.is-entering,
    .button__pad[data-busy] {
      animation: none;
    }

    .lock__panel.is-leaving {
      transition: none;
    }
  }
</style>
