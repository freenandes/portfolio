---
/**
 * PasswordGate — client-side unlock for a locked project.
 * Renders a passphrase form; on success it decrypts the project body in the
 * browser and renders the Markdown. Nothing secret is in the HTML.
 */
import RegMark from './RegMark.astro';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="lock" data-slug={slug} aria-live="polite">
  <div class="lock__panel" data-lock-form>
    <div class="lock__head">
      <RegMark size={18} />
      <p class="label">Restricted / Encrypted</p>
    </div>
    <h2 class="lock__title">This case study is locked</h2>
    <p class="lock__copy">
      The full write-up is encrypted. Enter the passphrase I shared with you to
      decrypt it in your browser.
    </p>

    <form class="lock__form" data-lock-submit novalidate>
      <label class="visually-hidden" for={`pw-${slug}`}>Passphrase</label>
      <input
        id={`pw-${slug}`}
        name="password"
        type="password"
        class="lock__input"
        placeholder="Passphrase"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      />
      <button type="submit" class="lock__btn">
        <span data-btn-label>Unlock</span>
      </button>
    </form>

    <p class="lock__error" data-lock-error role="alert" hidden>
      That passphrase didn't work. Try again.
    </p>
  </div>

  <article class="prose lock__content" data-lock-content hidden></article>
</section>

<script>
  import { fetchPayload, decryptMarkdown } from '../lib/decrypt';
  import { marked } from 'marked';

  const root = document.querySelector<HTMLElement>('.lock');
  if (root) {
    const slug = root.dataset.slug!;
    const form = root.querySelector<HTMLFormElement>('[data-lock-submit]')!;
    const panel = root.querySelector<HTMLElement>('[data-lock-form]')!;
    const input = root.querySelector<HTMLInputElement>('input[name="password"]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-lock-error]')!;
    const content = root.querySelector<HTMLElement>('[data-lock-content]')!;
    const btnLabel = root.querySelector<HTMLElement>('[data-btn-label]')!;

    let payloadPromise: ReturnType<typeof fetchPayload> | null = null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const password = input.value.trim();
      if (!password) return;

      btnLabel.textContent = 'Unlocking…';
      try {
        payloadPromise ??= fetchPayload(slug);
        const payload = await payloadPromise;
        const markdown = await decryptMarkdown(payload, password);

        content.innerHTML = await marked.parse(markdown);
        content.hidden = false;
        panel.hidden = true;
        content.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        // Wrong password → AES-GCM throws. Also handles fetch failures.
        payloadPromise = null;
        errorEl.hidden = false;
        input.value = '';
        input.focus();
      } finally {
        btnLabel.textContent = 'Unlock';
      }
    });
  }
</script>

<style>
  .lock {
    margin-block-start: var(--space-xl);
  }

  .lock__panel {
    max-width: 38rem;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-md), 4vw, var(--space-xl));
    box-shadow: var(--shadow-soft);
    position: relative;
    overflow: hidden;
  }
  .lock__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.18;
    pointer-events: none;
  }

  .lock__head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-end: var(--space-md);
    position: relative;
  }

  .lock__title {
    font-size: var(--step-2);
    position: relative;
  }

  .lock__copy {
    color: var(--ink-2);
    margin-block-start: var(--space-xs);
    max-width: 34ch;
    position: relative;
  }

  .lock__form {
    display: flex;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
    position: relative;
    flex-wrap: wrap;
  }

  .lock__input {
    flex: 1 1 14rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    transition: border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }
  .lock__input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 25%, transparent);
  }

  .lock__btn {
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-pill);
    padding: 0.7rem 1.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: transform var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }
  .lock__btn:hover {
    transform: translateY(-1px);
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }
  .lock__btn:active {
    transform: translateY(0);
  }

  .lock__error {
    margin-block-start: var(--space-sm);
    color: #b4452f;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    position: relative;
  }
</style>
