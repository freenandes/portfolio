---
import { site } from '../site.config';
import { withBase, normalizePath } from '../lib/base';
import RegMark from './RegMark.astro';

const path = normalizePath(Astro.url.pathname);
const home = normalizePath(withBase('/'));
const isActive = (href: string) => {
  const target = normalizePath(withBase(href));
  return href === '/' ? path === home : path.startsWith(target);
};
---

<header class="site-header">
  <div class="container bar">
    <a class="mark" href={withBase('/')} aria-label={`${site.name} — home`}>
      <RegMark size={14} />
      <span class="mark__text">{site.mark}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ol role="list" class="nav__list">
        {
          site.nav.map((item, i) => (
            <li class="nav__item">
              <a
                href={withBase(item.href)}
                class:list={['nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span class="nav__index">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in oklab, var(--paper) 80%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-block-end: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    gap: var(--space-m);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: var(--tracking-mono);
    transition: opacity var(--dur-fast) var(--ease);
  }
  .mark:hover {
    opacity: 0.6;
  }
  .mark__text {
    font-size: var(--step-0);
  }

  .nav__list {
    display: flex;
    gap: clamp(var(--space-s), 3vw, var(--space-l));
    margin: 0;
  }

  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5ch;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    padding-block: 0.4rem;
    position: relative;
    color: var(--ink-2);
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__link:hover {
    color: var(--ink);
  }
  .nav__index {
    font-size: 0.7em;
    color: var(--ink-3);
  }
  .nav__link.is-active {
    color: var(--ink);
  }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
</style>
