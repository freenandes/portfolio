---
/* =========================================================================
   NavDiagram — the kinetic mind-map that *is* the site navigation.

   Markup is generated from `src/diagram.config.ts`. Nodes are real, focusable
   buttons (with links inside their reveal panels), so the diagram is keyboard-
   and screen-reader navigable. A small vanilla-JS spring simulation (below)
   gives the graph its "live molecule" give: edges behave like springs, the
   pointer gently repels nearby nodes, and you can drag a node to tug the whole
   structure. Hovering / focusing / tapping a node calms it and reveals its
   panel. Everything degrades to a static, readable list without JS, and the
   simulation is skipped under `prefers-reduced-motion`.
   ========================================================================= */
import { diagramNodes, diagramEdges, type NodeShape } from '../diagram.config';
import { withBase } from '../lib/base';

// Node "points" are polygons (no circles). Compute the points string for a
// regular n-gon inscribed in a 20×20 viewBox, rotated to sit upright.
const SHAPE_SIDES: Record<NodeShape, number> = {
  triangle: 3,
  square: 4,
  pentagon: 5,
  hexagon: 6,
};
const SHAPE_ROT: Record<NodeShape, number> = {
  triangle: -90, // point up
  square: -45, // flat sides
  pentagon: -90, // point up
  hexagon: -90, // point top
};
function polygonPoints(shape: NodeShape = 'hexagon'): string {
  const sides = SHAPE_SIDES[shape] ?? 6;
  const rot = SHAPE_ROT[shape] ?? -90;
  const cx = 10;
  const cy = 10;
  const r = 8.4;
  const pts: string[] = [];
  for (let i = 0; i < sides; i++) {
    const a = ((rot + (i * 360) / sides) * Math.PI) / 180;
    pts.push(`${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`);
  }
  return pts.join(' ');
}

// Split the nodes so the markup mirrors the page's real outline: the identity
// node carries the page <h1>, the remaining single nodes are <h2> landmarks,
// and the case-study nodes are gathered into one labelled "Selected projects"
// group. Positioning is unchanged — nodes are absolutely placed by the
// simulation regardless of DOM nesting.
const projectNodes = diagramNodes.filter((n) => n.kind === 'project');
const otherNodes = diagramNodes.filter((n) => n.kind !== 'project');
---

<nav class="diagram" data-diagram aria-label="Site map — Pedro MC Fernandes">
  <svg class="diagram__links" data-links aria-hidden="true" focusable="false"></svg>
  <ul class="diagram__edges-data" hidden>
    {
      diagramEdges.map(([a, b]) => (
        <li data-a={a} data-b={b} />
      ))
    }
  </ul>

  {
    otherNodes.map((node) => {
      const Heading = node.kind === 'identity' ? 'h1' : 'h2';
      return (
        <div
          class:list={['node', `node--${node.kind}`, `node--${node.size ?? 'md'}`]}
          data-node
          data-id={node.id}
          data-place={node.place ?? 'bottom'}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
        >
          <Heading class="node__heading">
            <button
              class="node__hit"
              type="button"
              aria-expanded="false"
              aria-controls={`panel-${node.id}`}
            >
              <svg class="node__dot" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <polygon points={polygonPoints(node.shape)} />
              </svg>
              <span class="node__label">{node.label}</span>
            </button>
          </Heading>

          <div class="node__panel" id={`panel-${node.id}`} role="group" aria-label={node.label}>
            {node.meta && <p class="panel__meta mono">{node.meta}</p>}
            {node.tagline && <p class="panel__lead">{node.tagline}</p>}
            {node.lines?.map((line) => <p class="panel__text">{line}</p>)}

            {node.metrics && (
              <ul class="panel__metrics" role="list">
                {node.metrics.map((m) => (
                  <li class="panel__metric">
                    <span class="panel__metric-value">{m.value}</span>
                    <span class="panel__metric-label">{m.label}</span>
                  </li>
                ))}
              </ul>
            )}

            {node.email && (
              <a class="panel__link" href={`mailto:${node.email}`}>
                {node.email}
              </a>
            )}

            {node.link && (
              <a
                class="panel__link panel__cta"
                href={node.link.external ? node.link.href : withBase(node.link.href)}
                {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {node.link.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      );
    })
  }

  <div class="node-group" role="group" aria-label="Selected projects">
    {
      projectNodes.map((node) => (
        <div
          class:list={['node', `node--${node.kind}`, `node--${node.size ?? 'md'}`]}
          data-node
          data-id={node.id}
          data-place={node.place ?? 'bottom'}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
        >
          <h2 class="node__heading">
            <button
              class="node__hit"
              type="button"
              aria-expanded="false"
              aria-controls={`panel-${node.id}`}
            >
              <svg class="node__dot" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <polygon points={polygonPoints(node.shape)} />
              </svg>
              <span class="node__label">{node.label}</span>
            </button>
          </h2>

          <div class="node__panel" id={`panel-${node.id}`} role="group" aria-label={node.label}>
            {node.meta && <p class="panel__meta mono">{node.meta}</p>}
            {node.tagline && <p class="panel__lead">{node.tagline}</p>}
            {node.lines?.map((line) => <p class="panel__text">{line}</p>)}

            {node.tags && (
              <ul class="panel__tags" role="list">
                {node.tags.map((t) => (
                  <li class="panel__chip">{t}</li>
                ))}
              </ul>
            )}

            {node.link && (
              <a
                class="panel__link panel__cta"
                href={node.link.external ? node.link.href : withBase(node.link.href)}
                {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {node.link.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <p class="diagram__hint mono" data-hint aria-hidden="true">
    Hover to reveal · drag to feel the give · click your name to reset
  </p>
</nav>

<noscript>
  <style>
    /* No-JS fallback: collapse the simulation into a plain, readable list. */
    .diagram {
      height: auto !important;
      min-height: 0 !important;
      padding: var(--space-xl) var(--gutter) !important;
    }
    .diagram__links,
    .diagram__hint {
      display: none !important;
    }
    .node {
      position: static !important;
      transform: none !important;
      display: block !important;
      max-width: 40rem;
      margin-inline: auto;
      margin-block-end: var(--space-lg);
    }
    .node__panel {
      position: static !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      pointer-events: auto !important;
      margin-block-start: var(--space-sm);
    }
  </style>
</noscript>

<style>
  .diagram {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    touch-action: pan-y;
  }

  .diagram__edges-data {
    display: none;
  }

  .diagram__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .diagram__links :global(.link-line) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    opacity: 0.42;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The "Selected projects" wrapper is purely a semantic grouping — it must
     not create a stacking context or take up layout, so the nodes inside it
     stay absolutely positioned against the diagram exactly as before. */
  .node-group {
    display: contents;
  }

  /* ----------------------------- Nodes ----------------------------- */
  .node {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    will-change: transform;
  }
  .node:hover,
  .node:focus-within,
  .node.is-open,
  .node.is-dragging {
    z-index: 6;
  }

  /* Heading wrappers give the page a real outline without changing the look:
     they wrap the existing button and inherit all typography from it. */
  .node__heading {
    display: inline-flex;
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-wrap: nowrap;
  }

  .node__hit {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .node.is-dragging .node__hit {
    cursor: grabbing;
  }

  .node__dot {
    width: 15px;
    height: 15px;
    overflow: visible;
    flex: none;
    transition: transform var(--dur-fast) var(--ease);
  }
  .node--lg .node__dot {
    width: 21px;
    height: 21px;
  }
  .node--sm .node__dot {
    width: 11px;
    height: 11px;
  }
  .node__dot polygon {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
    transition: fill var(--dur-fast) var(--ease),
      stroke var(--dur-fast) var(--ease);
  }
  .node--lg .node__dot polygon {
    stroke-width: 1.9;
  }
  .node__hit:hover .node__dot,
  .node:focus-within .node__dot,
  .node.is-open .node__dot {
    transform: scale(1.2);
  }
  .node__hit:hover .node__dot polygon,
  .node:focus-within .node__dot polygon,
  .node.is-open .node__dot polygon {
    fill: var(--accent);
    stroke: var(--accent-ink);
  }

  .node__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }
  .node__hit:hover .node__label,
  .node:focus-within .node__label,
  .node.is-open .node__label {
    color: var(--ink);
  }
  .node--identity .node__label {
    font-family: var(--font-sans);
    text-transform: none;
    letter-spacing: var(--tracking-tight);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink);
  }

  /* ----------------------------- Panel ----------------------------- */
  .node__panel {
    --shift: 8px;
    position: absolute;
    width: max-content;
    max-width: min(74vw, 19rem);
    padding: 0.85rem 1rem;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease),
      visibility var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .node--identity .node__panel {
    max-width: min(80vw, 22rem);
  }

  .node[data-place='bottom'] .node__panel {
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(var(--shift));
  }
  .node[data-place='top'] .node__panel {
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(calc(-1 * var(--shift)));
  }
  .node[data-place='right'] .node__panel {
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%) translateX(var(--shift));
  }
  .node[data-place='left'] .node__panel {
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%) translateX(calc(-1 * var(--shift)));
  }

  .node:hover .node__panel,
  .node:focus-within .node__panel,
  .node.is-open .node__panel {
    --shift: 0px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .panel__meta {
    color: var(--ink-3);
    margin-block-end: 0.35rem;
  }
  .panel__lead {
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--ink);
  }
  .node--about .panel__lead {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
  }
  .panel__text {
    margin-block-start: 0.5rem;
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--ink-2);
  }

  .panel__metrics {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    padding-block-start: 0.6rem;
    border-block-start: 1px solid var(--line);
  }
  .panel__metric {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
  }
  .panel__metric-value {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-ink);
    min-width: 4.2ch;
  }
  .panel__metric-label {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: 0.75rem;
  }
  .panel__chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--paper-2);
    color: var(--ink-2);
  }

  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    margin-block-start: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .panel__link:hover {
    color: var(--accent);
  }
  .panel__cta {
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }
  .panel__cta span {
    transition: transform var(--dur) var(--ease);
  }
  .panel__cta:hover span {
    transform: translateX(3px);
  }

  /* ----------------------------- Hint ------------------------------ */
  .diagram__hint {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(1rem, 4vh, 2.5rem);
    text-align: center;
    color: var(--ink-3);
    transition: opacity var(--dur-slow) var(--ease);
    z-index: 1;
  }
  .diagram[data-touched] .diagram__hint {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram__hint {
      display: none;
    }
  }
</style>

<script>
  type Node = {
    el: HTMLElement;
    id: string;
    /** Layout position as a fraction (0..1) of the padded canvas. Regenerated
        randomly on each load / reset; updated when a node is dragged. */
    frac: { x: number; y: number };
    x: number;
    y: number;
    vx: number;
    vy: number;
    fx: number;
    fy: number;
    ax: number;
    ay: number;
    /** Vertical offset from the node's box centre to its polygon point, so
        connectors attach to the shape rather than crossing the label. */
    dotDy: number;
    calm: boolean;
    dragging: boolean;
    hover: boolean;
    focus: boolean;
  };

  type EdgeShape = {
    kind: 'straight' | 'wave' | 'elbow';
    amp: number;
    waves: number;
    phase: number;
    /** Elbow bend position along the edge (0..1). */
    f: number;
    /** Elbow corner count: 'L' = one corner, 'Z' = a centred jog. */
    style: 'L' | 'Z';
  };

  function initDiagram(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('[data-links]');
    const edgeData = Array.from(
      root.querySelectorAll<HTMLElement>('.diagram__edges-data > li')
    );
    const nodeEls = Array.from(root.querySelectorAll<HTMLElement>('[data-node]'));
    if (!svg || !nodeEls.length) return;
    const svgEl: SVGSVGElement = svg;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SVG_NS = 'http://www.w3.org/2000/svg';

    const nodes: Node[] = nodeEls.map((el) => ({
      el,
      id: el.dataset.id || '',
      frac: { x: 0.5, y: 0.5 },
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      fx: 0,
      fy: 0,
      ax: 0,
      ay: 0,
      dotDy: 0,
      calm: false,
      dragging: false,
      hover: false,
      focus: false,
    }));
    const byId = new Map(nodes.map((n) => [n.id, n]));

    const edges = edgeData
      .map((li) => {
        const a = byId.get(li.dataset.a || '');
        const b = byId.get(li.dataset.b || '');
        if (!a || !b) return null;
        const line = document.createElementNS(SVG_NS, 'path');
        line.setAttribute('class', 'link-line');
        line.setAttribute('fill', 'none');
        svgEl.appendChild(line);
        const shape: EdgeShape = {
          kind: 'straight',
          amp: 0,
          waves: 1,
          phase: 0,
          f: 0.5,
          style: 'Z',
        };
        return { a, b, line, rest: 0, shape };
      })
      .filter(Boolean) as {
      a: Node;
      b: Node;
      line: SVGPathElement;
      rest: number;
      shape: EdgeShape;
    }[];

    // Order the nodes along the chain (the diagram is one open line) so the
    // random walk lays them out sequentially and the connectors read as a line.
    const chainOrder: Node[] = (() => {
      const adj = new Map<string, string[]>();
      for (const e of edges) {
        (adj.get(e.a.id) || adj.set(e.a.id, []).get(e.a.id)!).push(e.b.id);
        (adj.get(e.b.id) || adj.set(e.b.id, []).get(e.b.id)!).push(e.a.id);
      }
      const ends = [...adj.keys()].filter((id) => (adj.get(id) || []).length === 1);
      if (!ends.length) return nodes.slice();
      const order: Node[] = [];
      const seen = new Set<string>();
      let cur: string | undefined = ends[0];
      while (cur && !seen.has(cur)) {
        seen.add(cur);
        const n = byId.get(cur);
        if (n) order.push(n);
        cur = (adj.get(cur) || []).find((id) => !seen.has(id));
      }
      // Append any stragglers (defensive: not a clean path).
      for (const n of nodes) if (!seen.has(n.id)) order.push(n);
      return order;
    })();

    let W = 0;
    let H = 0;

    // --- Dynamic layout ------------------------------------------------------
    // The line is laid out fresh on every load / reset, but gently: the chain
    // is an evenly-spaced "spine" along the dominant axis, slightly tilted and
    // with a soft perpendicular meander. The shape varies between loads without
    // flinging nodes around. Stored as *fractions* so resizing just remaps.
    function inset() {
      const mx = Math.min(0.14 * W, 150);
      const my = Math.min(0.12 * H, 110);
      return { mx, my, iw: Math.max(1, W - 2 * mx), ih: Math.max(1, H - 2 * my) };
    }

    function generateLayout() {
      const rect = root.getBoundingClientRect();
      const landscape = rect.width > rect.height * 1.15;
      const n = chainOrder.length;
      // Spine direction: along the dominant axis, tilted by up to ±20°.
      const base = landscape ? 0 : Math.PI / 2;
      const ang = base + (Math.random() * 2 - 1) * (34 * Math.PI) / 180;
      const dx = Math.cos(ang);
      const dy = Math.sin(ang);
      const ox = -dy; // perpendicular
      const oy = dx;
      const half = 0.4; // along-axis half-extent
      let o = (Math.random() * 2 - 1) * 0.1; // perpendicular meander
      let vel = 0;
      for (let i = 0; i < n; i++) {
        const s = (n === 1 ? 0 : i / (n - 1) - 0.5) * 2 * half;
        vel += (Math.random() * 2 - 1) * 0.12;
        vel *= 0.74;
        o += vel;
        o = Math.max(-0.32, Math.min(0.32, o));
        const jit = (Math.random() * 2 - 1) * 0.035;
        const fx = Math.max(0.08, Math.min(0.92, 0.5 + dx * s + ox * o + dx * jit));
        const fy = Math.max(0.08, Math.min(0.92, 0.5 + dy * s + oy * o + dy * jit));
        chainOrder[i].frac = { x: fx, y: fy };
      }
    }

    // Each connector gets a calm style — straight, a single gentle wave, or a
    // clean right-angled elbow (one corner 'L' or a centred jog 'Z'), echoing
    // the routed look of the reference. Re-rolled with each new layout.
    function generateEdgeShapes() {
      for (const e of edges) {
        const r = Math.random();
        if (r < 0.22) {
          e.shape = { kind: 'straight', amp: 0, waves: 1, phase: 0, f: 0.5, style: 'Z' };
        } else if (r < 0.58) {
          e.shape = {
            kind: 'wave',
            amp: 14 + Math.random() * 18,
            // Mostly a single hump; sometimes a gentle S-curve.
            waves: Math.random() < 0.3 ? 2 : 1,
            phase: Math.random() < 0.5 ? 0 : Math.PI,
            f: 0.5,
            style: 'Z',
          };
        } else {
          e.shape = {
            kind: 'elbow',
            // Signed perpendicular jog height (guaranteed visible regardless of
            // how aligned the two nodes happen to be).
            amp: (22 + Math.random() * 22) * (Math.random() < 0.5 ? 1 : -1),
            waves: 1,
            phase: 0,
            f: 0.4 + Math.random() * 0.2,
            style: Math.random() < 0.5 ? 'L' : 'Z',
          };
        }
      }
    }

    // Measure each node's polygon-point offset from its box centre (once the
    // labels are laid out), so connectors meet the shape, not the text.
    function measureDotOffsets() {
      for (const n of nodes) {
        const dot = n.el.querySelector('.node__dot');
        if (!dot) continue;
        const nr = n.el.getBoundingClientRect();
        const dr = dot.getBoundingClientRect();
        n.dotDy = dr.top + dr.height / 2 - (nr.top + nr.height / 2);
      }
    }

    // Build the SVG path for an edge from its current endpoints + its shape.
    function edgePath(e: { a: Node; b: Node; shape: EdgeShape }): string {
      const ax = e.a.x;
      const ay = e.a.y + e.a.dotDy;
      const bx = e.b.x;
      const by = e.b.y + e.b.dotDy;
      const dx = bx - ax;
      const dy = by - ay;
      const len = Math.hypot(dx, dy) || 1;
      const s = e.shape;
      if (s.kind === 'straight' || len < 4) return `M ${ax} ${ay} L ${bx} ${by}`;

      if (s.kind === 'wave') {
        const nx = -dy / len;
        const ny = dx / len;
        const segs = 24;
        let d = `M ${ax} ${ay}`;
        for (let i = 1; i <= segs; i++) {
          const t = i / segs;
          // Gentle hump (waves=1) or a soft S-curve (waves=2); zero at both
          // ends since waves is an integer and phase is 0 or π.
          const off = Math.sin(t * Math.PI * s.waves + s.phase) * s.amp;
          const x = ax + dx * t + nx * off;
          const y = ay + dy * t + ny * off;
          d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        return d;
      }

      // Elbow: a clean right-angled jog relative to the edge direction — a
      // small step out and back, echoing the routed look of the reference.
      // 'L' is a single corner; 'Z' is the full step. Both have crisp 90°
      // angles because the jog is perpendicular to the A→B direction.
      const r2 = (v: number) => v.toFixed(1);
      const ux = dx / len;
      const uy = dy / len;
      const px = -uy; // perpendicular unit
      const py = ux;
      const amp = s.amp;
      if (s.style === 'L') {
        // One corner: go along to f, step across to B's offset, then in to B.
        const a1 = len * s.f;
        const c1x = ax + ux * a1;
        const c1y = ay + uy * a1;
        const c2x = c1x + px * amp;
        const c2y = c1y + py * amp;
        return `M ${r2(ax)} ${r2(ay)} L ${r2(c1x)} ${r2(c1y)} L ${r2(c2x)} ${r2(c2y)} L ${r2(bx)} ${r2(by)}`;
      }
      // 'Z' step: along → out → along (offset) → back → along to B.
      const g = 0.18; // length of the offset run, as a fraction of the edge
      const a1 = len * Math.max(0.05, s.f - g / 2);
      const a2 = len * Math.min(0.95, s.f + g / 2);
      const p1x = ax + ux * a1;
      const p1y = ay + uy * a1;
      const p2x = p1x + px * amp;
      const p2y = p1y + py * amp;
      const p3x = ax + ux * a2 + px * amp;
      const p3y = ay + uy * a2 + py * amp;
      const p4x = ax + ux * a2;
      const p4y = ay + uy * a2;
      return (
        `M ${r2(ax)} ${r2(ay)} L ${r2(p1x)} ${r2(p1y)} L ${r2(p2x)} ${r2(p2y)} ` +
        `L ${r2(p3x)} ${r2(p3y)} L ${r2(p4x)} ${r2(p4y)} L ${r2(bx)} ${r2(by)}`
      );
    }

    function recomputeRests() {
      for (const e of edges) {
        e.rest = Math.hypot(e.a.ax - e.b.ax, e.a.ay - e.b.ay);
      }
    }

    function placeFor(n: Node): string {
      const right = W - n.ax;
      const left = n.ax;
      const top = n.ay;
      const bottom = H - n.ay;
      const needH = 300;
      const needV = 230;
      const opts: [string, number][] = [
        ['right', right - needH],
        ['left', left - needH],
        ['bottom', bottom - needV],
        ['top', top - needV],
      ];
      opts.sort((p, q) => q[1] - p[1]);
      return opts[0][0];
    }

    // Map the stored fractions to pixel anchors for the current size. A resize
    // only remaps (no re-randomising), so the chosen shape is preserved.
    function computeAnchors(first = false) {
      const rect = root.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      svgEl.setAttribute('width', String(W));
      svgEl.setAttribute('height', String(H));
      const { mx, my, iw, ih } = inset();
      for (const n of nodes) {
        n.ax = mx + n.frac.x * iw;
        n.ay = my + n.frac.y * ih;
        if (first) {
          n.x = n.ax + (Math.random() - 0.5) * 18;
          n.y = n.ay + (Math.random() - 0.5) * 18;
        }
        n.el.dataset.place = placeFor(n);
      }
      recomputeRests();
    }

    // A fresh random shape: new positions + new connector styles, animated to.
    function resetLayout() {
      generateLayout();
      generateEdgeShapes();
      computeAnchors();
      wake();
    }

    const pointer = { x: 0, y: 0, active: false };

    function render() {
      for (const n of nodes) {
        n.el.style.transform = `translate(${n.x}px, ${n.y}px) translate(-50%, -50%)`;
      }
      for (const e of edges) {
        e.line.setAttribute('d', edgePath(e));
      }
    }

    // The simulation only runs while there is something to resolve — settling
    // after load, a resize, a drag, or pointer interaction. Once everything is
    // at rest it sleeps (no rAF), so a stationary diagram is truly static.
    let raf = 0;
    let running = false;
    let settledFrames = 0;

    function wake() {
      settledFrames = 0;
      if (!running) {
        running = true;
        raf = requestAnimationFrame(frame);
      }
    }

    function frame() {
      for (const n of nodes) {
        n.fx = 0;
        n.fy = 0;
      }
      for (const e of edges) {
        const dx = e.b.x - e.a.x;
        const dy = e.b.y - e.a.y;
        const d = Math.hypot(dx, dy) || 1;
        const f = (d - e.rest) * 0.026;
        const ux = (dx / d) * f;
        const uy = (dy / d) * f;
        e.a.fx += ux;
        e.a.fy += uy;
        e.b.fx -= ux;
        e.b.fy -= uy;
      }

      let maxMotion = 0;
      let anyDragging = false;
      for (const n of nodes) {
        if (n.dragging) {
          anyDragging = true;
          continue;
        }
        if (n.calm) {
          const mx = n.ax - n.x;
          const my = n.ay - n.y;
          n.x += mx * 0.2;
          n.y += my * 0.2;
          n.vx = 0;
          n.vy = 0;
          maxMotion = Math.max(maxMotion, Math.abs(mx) + Math.abs(my));
          continue;
        }
        let tx = n.ax;
        let ty = n.ay;
        // Pointer repulsion as a *bounded target offset* (not an accumulating
        // force), so a node nudges aside near the cursor but never outruns it —
        // you can always catch it to hover.
        if (pointer.active) {
          const dx = n.x - pointer.x;
          const dy = n.y - pointer.y;
          const d = Math.hypot(dx, dy);
          const R = 150;
          if (d < R && d > 0.01) {
            const off = (1 - d / R) * 52;
            tx += (dx / d) * off;
            ty += (dy / d) * off;
          }
        }
        n.fx += (tx - n.x) * 0.02;
        n.fy += (ty - n.y) * 0.02;
        n.vx = (n.vx + n.fx) * 0.9;
        n.vy = (n.vy + n.fy) * 0.9;
        n.x += n.vx;
        n.y += n.vy;
        maxMotion = Math.max(
          maxMotion,
          Math.abs(n.vx) + Math.abs(n.vy) + Math.abs(tx - n.x) + Math.abs(ty - n.y)
        );
      }
      render();

      if (anyDragging) {
        settledFrames = 0;
        raf = requestAnimationFrame(frame);
        return;
      }
      settledFrames = maxMotion < 0.12 ? settledFrames + 1 : 0;
      if (settledFrames >= 6) {
        // Fully at rest. Snap to exact anchors (unless the pointer is holding
        // nodes aside) and stop the loop until the next interaction.
        if (!pointer.active) {
          for (const n of nodes) {
            if (n.dragging) continue;
            n.x = n.ax;
            n.y = n.ay;
            n.vx = 0;
            n.vy = 0;
          }
          render();
        }
        running = false;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function setCalm(n: Node) {
      n.calm = n.hover || n.focus || n.el.classList.contains('is-open');
    }
    function setOpen(n: Node, open: boolean) {
      n.el.classList.toggle('is-open', open);
      n.el
        .querySelector('.node__hit')
        ?.setAttribute('aria-expanded', open ? 'true' : 'false');
      setCalm(n);
      wake();
    }
    function closeAll(except?: Node) {
      for (const n of nodes) if (n !== except) setOpen(n, false);
    }

    // Pointer repulsion field.
    root.addEventListener('pointermove', (ev) => {
      const r = root.getBoundingClientRect();
      pointer.x = ev.clientX - r.left;
      pointer.y = ev.clientY - r.top;
      pointer.active = true;
      wake();
    });
    root.addEventListener('pointerleave', () => {
      pointer.active = false;
      wake();
    });

    // Close panels when clicking empty canvas; flag first interaction.
    root.addEventListener('pointerdown', (ev) => {
      root.dataset.touched = '1';
      if (!(ev.target as HTMLElement).closest('[data-node]')) closeAll();
    });
    root.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') closeAll();
    });

    // Per-node interaction: hover/focus calming, drag, and tap-to-toggle.
    for (const n of nodes) {
      const hit = n.el.querySelector<HTMLButtonElement>('.node__hit');
      if (!hit) continue;

      n.el.addEventListener('pointerenter', () => {
        n.hover = true;
        setCalm(n);
        wake();
      });
      n.el.addEventListener('pointerleave', () => {
        n.hover = false;
        setCalm(n);
        wake();
      });
      n.el.addEventListener('focusin', () => {
        n.focus = true;
        setCalm(n);
        wake();
      });
      n.el.addEventListener('focusout', () => {
        n.focus = false;
        setCalm(n);
        wake();
      });

      let downX = 0;
      let downY = 0;
      let moved = false;
      let pid: number | null = null;

      hit.addEventListener('pointerdown', (ev) => {
        if (reduce) return;
        pid = ev.pointerId;
        downX = ev.clientX;
        downY = ev.clientY;
        moved = false;
        try {
          hit.setPointerCapture(pid);
        } catch {}
        wake();
      });
      hit.addEventListener('pointermove', (ev) => {
        if (pid === null) return;
        const dx = ev.clientX - downX;
        const dy = ev.clientY - downY;
        if (!moved && Math.hypot(dx, dy) > 6) {
          moved = true;
          n.dragging = true;
          n.el.classList.add('is-dragging');
        }
        if (n.dragging) {
          const r = root.getBoundingClientRect();
          n.x = ev.clientX - r.left;
          n.y = ev.clientY - r.top;
          n.vx = 0;
          n.vy = 0;
          wake();
        }
      });
      const endDrag = () => {
        if (pid === null) return;
        try {
          hit.releasePointerCapture(pid);
        } catch {}
        pid = null;
        if (n.dragging) {
          n.dragging = false;
          n.el.classList.remove('is-dragging');
          // Pin the node where it was dropped: store it as a fraction so it
          // settles there and survives resizes, and re-settle edge springs.
          const { mx, my, iw, ih } = inset();
          n.frac = {
            x: Math.max(0, Math.min(1, (n.x - mx) / iw)),
            y: Math.max(0, Math.min(1, (n.y - my) / ih)),
          };
          n.ax = n.x;
          n.ay = n.y;
          recomputeRests();
          n.el.dataset.place = placeFor(n);
          wake();
        }
      };
      hit.addEventListener('pointerup', endDrag);
      hit.addEventListener('pointercancel', endDrag);

      hit.addEventListener('click', (ev) => {
        if (moved) {
          ev.preventDefault();
          return;
        }
        // Clicking the identity node resets any user-arranged layout.
        if (n.id === 'pedro') resetLayout();
        const wasOpen = n.el.classList.contains('is-open');
        closeAll(n);
        setOpen(n, !wasOpen);
      });
    }

    // Resize handling (debounced to a frame).
    let resizeScheduled = false;
    const onResize = () => {
      if (resizeScheduled) return;
      resizeScheduled = true;
      requestAnimationFrame(() => {
        resizeScheduled = false;
        measureDotOffsets();
        computeAnchors();
        wake();
      });
    };
    const ro = new ResizeObserver(onResize);
    ro.observe(root);

    generateLayout();
    generateEdgeShapes();
    computeAnchors(true);
    render();
    measureDotOffsets();
    render();

    if (reduce) {
      for (const n of nodes) {
        n.x = n.ax;
        n.y = n.ay;
      }
      render();
      return;
    }

    // Settle from the initial scattered positions, then sleep.
    wake();

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
        running = false;
      } else {
        wake();
      }
    });
  }

  const root = document.querySelector<HTMLElement>('[data-diagram]');
  if (root) initDiagram(root);
</script>
