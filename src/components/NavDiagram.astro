---
/* =========================================================================
   NavDiagram — the kinetic mind-map that *is* the site navigation.

   Markup is generated from `src/diagram.config.ts`. Nodes are real, focusable
   buttons (with links inside their reveal panels), so the diagram is keyboard-
   and screen-reader navigable. A small vanilla-JS spring simulation (below)
   gives the graph its "live molecule" give: edges behave like springs, the
   pointer gently repels nearby nodes, and you can drag a node to tug the whole
   structure. Hovering / focusing / tapping a node calms it and reveals its
   panel. Everything degrades to a static, readable list without JS, and the
   simulation is skipped under `prefers-reduced-motion`.
   ========================================================================= */
import { diagramNodes, diagramEdges } from '../diagram.config';
import { withBase } from '../lib/base';
---

<section class="diagram" data-diagram aria-label="Pedro MC Fernandes — navigation map">
  <svg class="diagram__links" data-links aria-hidden="true" focusable="false"></svg>
  <ul class="diagram__edges-data" hidden>
    {
      diagramEdges.map(([a, b]) => (
        <li data-a={a} data-b={b} />
      ))
    }
  </ul>

  {
    diagramNodes.map((node) => (
      <div
        class:list={[
          'node',
          `node--${node.kind}`,
          `node--${node.size ?? 'md'}`,
        ]}
        data-node
        data-id={node.id}
        data-place={node.place ?? 'bottom'}
        data-px={node.portrait.x}
        data-py={node.portrait.y}
        data-lx={node.landscape.x}
        data-ly={node.landscape.y}
      >
        <button
          class="node__hit"
          type="button"
          aria-expanded="false"
          aria-controls={`panel-${node.id}`}
        >
          <span class="node__dot" aria-hidden="true" />
          <span class="node__label">{node.label}</span>
        </button>

        <div class="node__panel" id={`panel-${node.id}`} role="group" aria-label={node.label}>
          {node.meta && <p class="panel__meta mono">{node.meta}</p>}
          {node.tagline && <p class="panel__lead">{node.tagline}</p>}
          {node.lines?.map((line) => <p class="panel__text">{line}</p>)}

          {node.metrics && (
            <ul class="panel__metrics" role="list">
              {node.metrics.map((m) => (
                <li class="panel__metric">
                  <span class="panel__metric-value">{m.value}</span>
                  <span class="panel__metric-label">{m.label}</span>
                </li>
              ))}
            </ul>
          )}

          {node.tags && (
            <ul class="panel__tags" role="list">
              {node.tags.map((t) => (
                <li class="panel__chip">{t}</li>
              ))}
            </ul>
          )}

          {node.email && (
            <a class="panel__link" href={`mailto:${node.email}`}>
              {node.email}
            </a>
          )}

          {node.link && (
            <a
              class="panel__link panel__cta"
              href={node.link.external ? node.link.href : withBase(node.link.href)}
              {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {node.link.label} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    ))
  }

  <p class="diagram__hint mono" data-hint aria-hidden="true">
    Hover to reveal · drag to feel the give
  </p>
</section>

<noscript>
  <style>
    /* No-JS fallback: collapse the simulation into a plain, readable list. */
    .diagram {
      height: auto !important;
      min-height: 0 !important;
      padding: var(--space-xl) var(--gutter) !important;
    }
    .diagram__links,
    .diagram__hint {
      display: none !important;
    }
    .node {
      position: static !important;
      transform: none !important;
      display: block !important;
      max-width: 40rem;
      margin-inline: auto;
      margin-block-end: var(--space-lg);
    }
    .node__panel {
      position: static !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      pointer-events: auto !important;
      margin-block-start: var(--space-sm);
    }
  </style>
</noscript>

<style>
  .diagram {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    touch-action: pan-y;
  }

  .diagram__edges-data {
    display: none;
  }

  .diagram__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .diagram__links :global(.link-line) {
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0.28;
    stroke-linecap: round;
  }

  /* ----------------------------- Nodes ----------------------------- */
  .node {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    will-change: transform;
  }
  .node:hover,
  .node:focus-within,
  .node.is-open,
  .node.is-dragging {
    z-index: 6;
  }

  .node__hit {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .node.is-dragging .node__hit {
    cursor: grabbing;
  }

  .node__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    transition: transform var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .node--lg .node__dot {
    width: 17px;
    height: 17px;
    border-width: 2px;
  }
  .node--sm .node__dot {
    width: 8px;
    height: 8px;
  }
  .node__hit:hover .node__dot,
  .node:focus-within .node__dot,
  .node.is-open .node__dot {
    background: var(--accent);
    border-color: var(--accent-ink);
    transform: scale(1.25);
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .node__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }
  .node__hit:hover .node__label,
  .node:focus-within .node__label,
  .node.is-open .node__label {
    color: var(--ink);
  }
  .node--identity .node__label {
    font-family: var(--font-sans);
    text-transform: none;
    letter-spacing: var(--tracking-tight);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink);
  }

  /* ----------------------------- Panel ----------------------------- */
  .node__panel {
    --shift: 8px;
    position: absolute;
    width: max-content;
    max-width: min(74vw, 19rem);
    padding: 0.85rem 1rem;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease),
      visibility var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .node--identity .node__panel {
    max-width: min(80vw, 22rem);
  }

  .node[data-place='bottom'] .node__panel {
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(var(--shift));
  }
  .node[data-place='top'] .node__panel {
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(calc(-1 * var(--shift)));
  }
  .node[data-place='right'] .node__panel {
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%) translateX(var(--shift));
  }
  .node[data-place='left'] .node__panel {
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%) translateX(calc(-1 * var(--shift)));
  }

  .node:hover .node__panel,
  .node:focus-within .node__panel,
  .node.is-open .node__panel {
    --shift: 0px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .panel__meta {
    color: var(--ink-3);
    margin-block-end: 0.35rem;
  }
  .panel__lead {
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--ink);
  }
  .node--about .panel__lead {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
  }
  .panel__text {
    margin-block-start: 0.5rem;
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--ink-2);
  }

  .panel__metrics {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    padding-block-start: 0.6rem;
    border-block-start: 1px solid var(--line);
  }
  .panel__metric {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
  }
  .panel__metric-value {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-ink);
    min-width: 4.2ch;
  }
  .panel__metric-label {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: 0.75rem;
  }
  .panel__chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--paper-2);
    color: var(--ink-2);
  }

  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    margin-block-start: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .panel__link:hover {
    color: var(--accent);
  }
  .panel__cta {
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }
  .panel__cta span {
    transition: transform var(--dur) var(--ease);
  }
  .panel__cta:hover span {
    transform: translateX(3px);
  }

  /* ----------------------------- Hint ------------------------------ */
  .diagram__hint {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(1rem, 4vh, 2.5rem);
    text-align: center;
    color: var(--ink-3);
    transition: opacity var(--dur-slow) var(--ease);
    z-index: 1;
  }
  .diagram[data-touched] .diagram__hint {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram__hint {
      display: none;
    }
  }
</style>

<script>
  type Node = {
    el: HTMLElement;
    id: string;
    portrait: { x: number; y: number };
    landscape: { x: number; y: number };
    x: number;
    y: number;
    vx: number;
    vy: number;
    fx: number;
    fy: number;
    ax: number;
    ay: number;
    phase: number;
    calm: boolean;
    dragging: boolean;
    hover: boolean;
    focus: boolean;
  };

  function initDiagram(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('[data-links]');
    const edgeData = Array.from(
      root.querySelectorAll<HTMLElement>('.diagram__edges-data > li')
    );
    const nodeEls = Array.from(root.querySelectorAll<HTMLElement>('[data-node]'));
    if (!svg || !nodeEls.length) return;
    const svgEl: SVGSVGElement = svg;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SVG_NS = 'http://www.w3.org/2000/svg';

    const nodes: Node[] = nodeEls.map((el) => ({
      el,
      id: el.dataset.id || '',
      portrait: { x: +(el.dataset.px || 0.5), y: +(el.dataset.py || 0.5) },
      landscape: { x: +(el.dataset.lx || 0.5), y: +(el.dataset.ly || 0.5) },
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      fx: 0,
      fy: 0,
      ax: 0,
      ay: 0,
      phase: Math.random() * Math.PI * 2,
      calm: false,
      dragging: false,
      hover: false,
      focus: false,
    }));
    const byId = new Map(nodes.map((n) => [n.id, n]));

    const edges = edgeData
      .map((li) => {
        const a = byId.get(li.dataset.a || '');
        const b = byId.get(li.dataset.b || '');
        if (!a || !b) return null;
        const line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('class', 'link-line');
        svgEl.appendChild(line);
        return { a, b, line, rest: 0 };
      })
      .filter(Boolean) as { a: Node; b: Node; line: SVGLineElement; rest: number }[];

    let W = 0;
    let H = 0;

    function placeFor(n: Node): string {
      const right = W - n.ax;
      const left = n.ax;
      const top = n.ay;
      const bottom = H - n.ay;
      const needH = 300;
      const needV = 230;
      const opts: [string, number][] = [
        ['right', right - needH],
        ['left', left - needH],
        ['bottom', bottom - needV],
        ['top', top - needV],
      ];
      opts.sort((p, q) => q[1] - p[1]);
      return opts[0][0];
    }

    function computeAnchors(first = false) {
      const rect = root.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      svgEl.setAttribute('width', String(W));
      svgEl.setAttribute('height', String(H));
      const landscape = W > H * 1.15;
      const padX = Math.min(0.16 * W, 180);
      const padY = Math.min(0.12 * H, 120);
      for (const n of nodes) {
        const src = landscape ? n.landscape : n.portrait;
        n.ax = padX + src.x * (W - 2 * padX);
        n.ay = padY + src.y * (H - 2 * padY);
        if (first) {
          n.x = n.ax + (Math.random() - 0.5) * 18;
          n.y = n.ay + (Math.random() - 0.5) * 18;
        }
        n.el.dataset.place = placeFor(n);
      }
      for (const e of edges) {
        e.rest = Math.hypot(e.a.ax - e.b.ax, e.a.ay - e.b.ay);
      }
    }

    const pointer = { x: 0, y: 0, active: false };

    function render() {
      for (const n of nodes) {
        n.el.style.transform = `translate(${n.x}px, ${n.y}px) translate(-50%, -50%)`;
      }
      for (const e of edges) {
        e.line.setAttribute('x1', String(e.a.x));
        e.line.setAttribute('y1', String(e.a.y));
        e.line.setAttribute('x2', String(e.b.x));
        e.line.setAttribute('y2', String(e.b.y));
      }
    }

    let raf = 0;
    function frame(t: number) {
      const time = t / 1000;
      for (const n of nodes) {
        n.fx = 0;
        n.fy = 0;
      }
      for (const e of edges) {
        const dx = e.b.x - e.a.x;
        const dy = e.b.y - e.a.y;
        const d = Math.hypot(dx, dy) || 1;
        const f = (d - e.rest) * 0.026;
        const ux = (dx / d) * f;
        const uy = (dy / d) * f;
        e.a.fx += ux;
        e.a.fy += uy;
        e.b.fx -= ux;
        e.b.fy -= uy;
      }
      for (const n of nodes) {
        if (n.dragging) continue;
        if (n.calm) {
          n.x += (n.ax - n.x) * 0.18;
          n.y += (n.ay - n.y) * 0.18;
          n.vx *= 0.6;
          n.vy *= 0.6;
          continue;
        }
        // Idle "breathing": a slow two-frequency wander so the molecule
        // visibly floats even when untouched.
        let tx = n.ax;
        let ty = n.ay;
        tx += Math.cos(time * 0.65 + n.phase) * 24 + Math.sin(time * 0.28 + n.phase) * 11;
        ty += Math.sin(time * 0.57 + n.phase * 1.3) * 24 + Math.cos(time * 0.22 + n.phase) * 11;
        // Pointer repulsion as a *bounded target offset* (not an accumulating
        // force), so a node nudges aside near the cursor but never outruns it —
        // you can always catch it to hover.
        if (pointer.active) {
          const dx = n.x - pointer.x;
          const dy = n.y - pointer.y;
          const d = Math.hypot(dx, dy);
          const R = 150;
          if (d < R && d > 0.01) {
            const off = (1 - d / R) * 52;
            tx += (dx / d) * off;
            ty += (dy / d) * off;
          }
        }
        n.fx += (tx - n.x) * 0.02;
        n.fy += (ty - n.y) * 0.02;
        n.vx = (n.vx + n.fx) * 0.92;
        n.vy = (n.vy + n.fy) * 0.92;
        n.x += n.vx;
        n.y += n.vy;
      }
      render();
      raf = requestAnimationFrame(frame);
    }

    function setCalm(n: Node) {
      n.calm = n.hover || n.focus || n.el.classList.contains('is-open');
    }
    function setOpen(n: Node, open: boolean) {
      n.el.classList.toggle('is-open', open);
      n.el
        .querySelector('.node__hit')
        ?.setAttribute('aria-expanded', open ? 'true' : 'false');
      setCalm(n);
    }
    function closeAll(except?: Node) {
      for (const n of nodes) if (n !== except) setOpen(n, false);
    }

    // Pointer repulsion field.
    root.addEventListener('pointermove', (ev) => {
      const r = root.getBoundingClientRect();
      pointer.x = ev.clientX - r.left;
      pointer.y = ev.clientY - r.top;
      pointer.active = true;
    });
    root.addEventListener('pointerleave', () => {
      pointer.active = false;
    });

    // Close panels when clicking empty canvas; flag first interaction.
    root.addEventListener('pointerdown', (ev) => {
      root.dataset.touched = '1';
      if (!(ev.target as HTMLElement).closest('[data-node]')) closeAll();
    });
    root.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') closeAll();
    });

    // Per-node interaction: hover/focus calming, drag, and tap-to-toggle.
    for (const n of nodes) {
      const hit = n.el.querySelector<HTMLButtonElement>('.node__hit');
      if (!hit) continue;

      n.el.addEventListener('pointerenter', () => {
        n.hover = true;
        setCalm(n);
      });
      n.el.addEventListener('pointerleave', () => {
        n.hover = false;
        setCalm(n);
      });
      n.el.addEventListener('focusin', () => {
        n.focus = true;
        setCalm(n);
      });
      n.el.addEventListener('focusout', () => {
        n.focus = false;
        setCalm(n);
      });

      let downX = 0;
      let downY = 0;
      let moved = false;
      let pid: number | null = null;

      hit.addEventListener('pointerdown', (ev) => {
        if (reduce) return;
        pid = ev.pointerId;
        downX = ev.clientX;
        downY = ev.clientY;
        moved = false;
        try {
          hit.setPointerCapture(pid);
        } catch {}
      });
      hit.addEventListener('pointermove', (ev) => {
        if (pid === null) return;
        const dx = ev.clientX - downX;
        const dy = ev.clientY - downY;
        if (!moved && Math.hypot(dx, dy) > 6) {
          moved = true;
          n.dragging = true;
          n.el.classList.add('is-dragging');
        }
        if (n.dragging) {
          const r = root.getBoundingClientRect();
          n.x = ev.clientX - r.left;
          n.y = ev.clientY - r.top;
          n.vx = 0;
          n.vy = 0;
        }
      });
      const endDrag = () => {
        if (pid === null) return;
        try {
          hit.releasePointerCapture(pid);
        } catch {}
        pid = null;
        if (n.dragging) {
          n.dragging = false;
          n.el.classList.remove('is-dragging');
        }
      };
      hit.addEventListener('pointerup', endDrag);
      hit.addEventListener('pointercancel', endDrag);

      hit.addEventListener('click', (ev) => {
        if (moved) {
          ev.preventDefault();
          return;
        }
        const wasOpen = n.el.classList.contains('is-open');
        closeAll(n);
        setOpen(n, !wasOpen);
      });
    }

    // Resize handling (debounced to a frame).
    let resizeScheduled = false;
    const onResize = () => {
      if (resizeScheduled) return;
      resizeScheduled = true;
      requestAnimationFrame(() => {
        resizeScheduled = false;
        computeAnchors();
      });
    };
    const ro = new ResizeObserver(onResize);
    ro.observe(root);

    computeAnchors(true);
    render();

    if (reduce) {
      for (const n of nodes) {
        n.x = n.ax;
        n.y = n.ay;
      }
      render();
      return;
    }

    raf = requestAnimationFrame(frame);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
      } else if (!raf) {
        raf = requestAnimationFrame(frame);
      }
    });
  }

  const root = document.querySelector<HTMLElement>('[data-diagram]');
  if (root) initDiagram(root);
</script>
