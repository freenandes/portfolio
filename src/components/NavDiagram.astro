---

/** Site map */

import { diagramNodes, diagramEdges, type NodeShape } from '../diagram.config';
import { withBase } from '../lib/base';
import { site } from '../site.config';

const SHAPE_SIDES: Record<NodeShape, number> = {
  triangle: 3,
  square: 4,
  pentagon: 5,
  hexagon: 6,
};
const SHAPE_ROT: Record<NodeShape, number> = {
  triangle: -90, // point up
  square: -45, // flat sides
  pentagon: -90, // point up
  hexagon: -90, // point top
};
function polygonPoints(shape: NodeShape = 'hexagon'): string {
  const sides = SHAPE_SIDES[shape] ?? 6;
  const rot = SHAPE_ROT[shape] ?? -90;
  const cx = 10;
  const cy = 10;
  const r = 8.4;
  const pts: string[] = [];
  for (let i = 0; i < sides; i++) {
    const a = ((rot + (i * 360) / sides) * Math.PI) / 180;
    pts.push(`${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`);
  }
  return pts.join(' ');
}
const RING_FONT = 12;
const RING_GAP_CHARS = 4;
function ringGeometry(label: string) {
  const advance = RING_FONT * 0.6 + RING_FONT * 0.125;
  const textLength = Math.max(label.length * advance, 90);
  const pathLength = textLength + RING_GAP_CHARS * advance;
  const r = pathLength / (2 * Math.PI);
  const pad = RING_FONT * 1.25;
  const size = Math.round(2 * (r + pad));
  const c = size / 2;
  const d = `M ${c} ${(c - r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(2 * r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(-2 * r).toFixed(2)}`;
  return { textLength: textLength.toFixed(2), size, d };
}
const projectNodes = diagramNodes.filter((n) => n.kind === 'project');
const floatingNodes = diagramNodes.filter((n) => n.kind === 'floating');
const otherNodes = diagramNodes.filter(
  (n) => n.kind !== 'project' && n.kind !== 'floating'
);

---

<nav class="diagram" data-diagram aria-label={`Site map — ${site.name}`}>
  <svg class="diagram__links" data-links aria-hidden="true" focusable="false"></svg>
  <ul class="diagram__edges-data" hidden>
    {
      diagramEdges.map(([a, b]) => (
        <li data-a={a} data-b={b} />
      ))
    }
  </ul>
  {
    otherNodes.map((node) => {
      const Heading = node.kind === 'identity' ? 'h1' : 'h2';
      const hasPanel = node.kind !== 'identity';
      return (
        <div
          class:list={['node', `node--${node.kind}`, `node--${node.size ?? 'md'}`]}
          data-node
          data-id={node.id}
          data-place={node.place ?? 'bottom'}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
        >
          <Heading class="node__heading">
            <button
              class="node__hit"
              type="button"
              {...(hasPanel
                ? { 'aria-expanded': 'false', 'aria-controls': `panel-${node.id}` }
                : {})}
            >
              <svg class="node__dot" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <polygon points={polygonPoints(node.shape)} />
              </svg>
              <span class="node__label">{node.label}</span>
              {node.subLabel && <span class="node__sublabel mono">{node.subLabel}</span>}
            </button>
          </Heading>
          {hasPanel && (
            <div class="node__panel" id={`panel-${node.id}`} role="group" aria-label={node.label}>
              {node.meta && <p class="panel__meta mono">{node.meta}</p>}
              {node.tagline && <p class="panel__lead">{node.tagline}</p>}
              {node.lines?.map((line) => <p class="panel__text">{line}</p>)}
              {node.metrics && (
                <ul class="panel__metrics" role="list">
                  {node.metrics.map((m) => (
                    <li class="panel__metric">
                      <span class="panel__metric-value">{m.value}</span>
                      <span class="panel__metric-label">{m.label}</span>
                    </li>
                  ))}
                </ul>
              )}
              {node.kind === 'contact' && (
                <ul class="panel__socials link-row" role="list">
                  {site.socials.map((s) => (
                    <li>
                      <a
                        class="link"
                        href={s.href}
                        rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                      >
                        {s.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {node.email && (
                <a class="panel__link link" href={`mailto:${node.email}`}>
                  {node.email}
                </a>
              )}
              {node.link && (
                <a
                  class="panel__link link panel__cta"
                  href={node.link.external ? node.link.href : withBase(node.link.href)}
                  {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {node.link.label}
                </a>
              )}
            </div>
          )}
        </div>
      );
    })
  }
  <div class="node-group" role="group" aria-label="Selected projects">
    {
      projectNodes.map((node) => (
        <div
          class:list={['node', `node--${node.kind}`, `node--${node.size ?? 'md'}`]}
          data-node
          data-id={node.id}
          data-place={node.place ?? 'bottom'}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
        >
          <h2 class="node__heading">
            <button
              class="node__hit"
              type="button"
              aria-expanded="false"
              aria-controls={`panel-${node.id}`}
            >
              <svg class="node__dot" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <polygon points={polygonPoints(node.shape)} />
              </svg>
              <span class="node__label">{node.label}</span>
            </button>
          </h2>
          <div class="node__panel" id={`panel-${node.id}`} role="group" aria-label={node.label}>
            {node.meta && <p class="panel__meta">{node.meta}</p>}
            {node.tagline && <p class="panel__lead">{node.tagline}</p>}
            {node.lines?.map((line) => <p class="panel__text">{line}</p>)}
            {node.tags && (
              <ul class="panel__tags meta-row" role="list">
                {node.tags.map((t) => (
                  <li class="meta">{t}</li>
                ))}
              </ul>
            )}
            {node.link && (
              <a
                class="panel__link link panel__cta"
                href={node.link.external ? node.link.href : withBase(node.link.href)}
                {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {node.link.label}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
  {
    floatingNodes.map((node) => {
      const ring = ringGeometry(node.label);
      return (
        <div
          class="node node--floating"
          data-node
          data-floating
          data-id={node.id}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
          aria-hidden="true"
        >
          <svg
            class="node__ring"
            style={`--ring-start: ${node.ringStart ?? 0}deg`}
            viewBox={`0 0 ${ring.size} ${ring.size}`}
            width={ring.size}
            height={ring.size}
            role="img"
            aria-label={node.label}
            focusable="false"
          >
            <defs>
              <path id={`ring-${node.id}`} d={ring.d} fill="none" />
            </defs>
            <text class="node__ring-text">
              <textPath
                href={`#ring-${node.id}`}
                startOffset="0"
                textLength={ring.textLength}
                lengthAdjust="spacingAndGlyphs"
              >
                {node.label}
              </textPath>
            </text>
          </svg>
        </div>
      );
    })
  }
</nav>
<noscript>
  <style>
    /* No-JS fallback: collapse the simulation into a plain, readable list. */
    .diagram {
      display: flex;
      flex-direction: column;
      height: auto !important;
      min-height: 0 !important;
      padding: var(--space-md) var(--space-md) !important;
    }

    .diagram__links {
      display: none !important;
    }

    .node {
      position: static !important;
      transform: none !important;
      display: flex !important;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 40rem;
      margin-inline: auto;
      margin-block-end: var(--space-lg);
    }

    .node__panel {
      position: static !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      pointer-events: auto !important;
      margin-block-start: var(--space-sm);
    }

    /* The entrance is held until the script has placed the map, so without
       scripting there is nothing to wait for. */

    .node,
    .node__dot,
    .link-line {
      animation: none !important;
    }
  </style>
</noscript>
<style>
  .diagram {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    touch-action: pan-y;
  }

  .diagram__edges-data {
    display: none;
  }

  .diagram__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .diagram__links :global(.link-line) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.375;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Entrance — the map draws itself once: markers land along the chain, then
     each connector is traced between the two it joins. The script sets the
     per-element delay and releases the hold only after it has solved the
     layout, so nothing animates in from a spot it is about to leave. */

  @media (prefers-reduced-motion: no-preference) {
    .node {
      animation: node-in var(--dur) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .node__dot {
      animation: dot-in var(--dur) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .diagram__links :global(.link-line) {
      animation: edge-draw var(--dur-slow) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .diagram.is-mounted .node,
    .diagram.is-mounted .node__dot,
    .diagram.is-mounted .diagram__links :global(.link-line) {
      animation-play-state: running;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
    }
  }

  @keyframes dot-in {
    from {
      transform: scale(0.7);
    }
  }

  /* `pathLength="1"` (set by the script) makes these normalised units, so the
     trace holds up while the simulation is still nudging the endpoints. */

  @keyframes edge-draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }

  /* The "Selected projects" wrapper is purely a semantic grouping — it must not create a stacking context or take up layout, so the nodes inside it stay absolutely positioned against the diagram exactly as before. */

  .node-group {
    display: contents;
  }

  /* Nodes */

  .node {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    will-change: transform;
  }

  .node:hover,
  .node:focus-within,
  .node.is-open,
  .node.is-dragging {
    z-index: 6;
  }

  /* Heading wrappers give the page a real outline without changing the look: they wrap the existing button and inherit all typography from it. */

  .node__heading {
    display: inline-flex;
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-wrap: nowrap;
  }

  .node__hit {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm);
    background: none;
    border: 0;
    color: var(--ink);
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .node.is-dragging .node__hit {
    cursor: grabbing;
  }

  .node__dot {
    width: 1rem;
    height: 1rem;
    overflow: visible;
    flex: none;
    transition: transform var(--dur-fast) var(--ease);
  }

  .node--lg .node__dot {
    width: 1.25rem;
    height: 1.25rem;
  }

  .node--sm .node__dot {
    width: 0.875rem;
    height: 0.875rem;
  }

  .node__dot polygon {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.75;
    vector-effect: non-scaling-stroke;
    transition: fill var(--dur-fast) var(--ease),
      stroke var(--dur-fast) var(--ease);
  }

  .node--lg .node__dot polygon {
    stroke-width: 2;
  }

  .node__hit:hover .node__dot,
  .node:focus-within .node__dot,
  .node.is-open .node__dot {
    transform: scale(1.25);
  }

  .node__hit:hover .node__dot polygon,
  .node:focus-within .node__dot polygon,
  .node.is-open .node__dot polygon {
    fill: var(--accent);
    stroke: var(--accent-ink);
  }

  .node__label,
  .node__sublabel {
    /* Knockout plate — a single solid paper-coloured box behind each label so connector lines are masked completely. */
    --ko: var(--paper);
    --ko-px: 0.25em;
    --ko-py: 0;
    --ko-radius: var(--radius-sm);

    display: inline-block;
    padding: var(--ko-py) var(--ko-px);
    margin: calc(-1 * var(--ko-py)) calc(-1 * var(--ko-px));
    background-color: var(--ko);
    border-radius: var(--ko-radius);

    /* Labels */
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);

  }

  .node__hit:hover .node__label,
  .node__hit:hover .node__sublabel,
  .node:focus-within .node__label,
  .node.is-open .node__label {
    color: var(--ink);
  }

  .node--identity .node__label {
    font-family: var(--font-sans);
    text-transform: none;
    letter-spacing: var(--tracking-tight);
    font-size: var(--step-0);
    font-weight: var(--weight-bold);
    color: var(--ink-2);
  }

  /* Floating nodes */
  
  .node--floating {
    pointer-events: none;
    z-index: 0;
  }

  .node__ring {
    display: block;
    overflow: visible;
    transform-origin: center;
    transform: rotate(var(--ring-start, 0deg));
  }

  @keyframes ring-spin {
    from {
      transform: rotate(var(--ring-start, 0deg));
    }

    to {
      transform: rotate(calc(var(--ring-start, 0deg) - 360deg));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .node--floating .node__ring {
      animation: ring-spin 30s linear infinite;
    }
  }

  .node__ring-text {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    fill: var(--ink-faint);
  }

  /* Node's panel */

  .node__panel {
    --shift: 0.5rem;

    /* JS sets these to pull a card back inside the viewport when its node sits near an edge (see clampPanel). 0 = no correction needed. */
    --panel-nudge-x: 0px;
    --panel-nudge-y: 0px;

    position: absolute;
    width: max-content;
    max-width: min(90vw, 20rem);
    padding: 0.875rem 1rem;
    background: var(--paper);
    outline: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    /* The viewport correction rides on `translate`, which is left out of the
       transition below: it must land instantly, or a card near an edge would
       appear to slide in from the wrong place. */
    translate: var(--panel-nudge-x) var(--panel-nudge-y);

    /* Leaving is quicker than arriving: a card you have moved away from should
       get out of the way, a card you asked for should settle. */
    transition: opacity var(--dur-fast) var(--ease),
      visibility var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .node[data-place='bottom'] .node__panel {
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(var(--shift));
  }

  .node[data-place='top'] .node__panel {
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(calc(-1 * var(--shift)));
  }

  .node[data-place='right'] .node__panel {
    left: 100%;
    top: 50%;
    transform: translateY(-50%) translateX(var(--shift));
  }

  .node[data-place='left'] .node__panel {
    right: 100%;
    top: 50%;
    transform: translateY(-50%) translateX(calc(-1 * var(--shift)));
  }

  .node:hover .node__panel,
  .node:focus-within .node__panel,
  .node.is-open .node__panel {
    --shift: 0px;

    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-duration: var(--dur);
  }

  /* Hover intent: a pointer crossing the map shouldn't trip every card on the
     way. Deliberate opens — click, or keyboard focus — never wait. */

  .node:hover .node__panel {
    transition-delay: var(--delay-hover);
  }

  .node:focus-within .node__panel,
  .node.is-open .node__panel {
    transition-delay: 0s;
  }

  .panel__meta {
    margin-block-end: var(--space-md);
    color: var(--ink-3);
  }

  .panel__lead,
  .node--about .panel__lead {
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-md);
  }

  .panel__meta,
  .panel__text,
  .panel__lead,
  .node--about .panel__lead {
    font-size: var(--step-0);
    line-height: var(--leading-snug);
  }

  .panel__meta,
  .panel__text {
    font-weight: var(--weight-regular);
  }

  .panel__tags {
    margin-block: var(--space-md) var(--space-xs);
  }

  .panel__link {
    display: inline-flex;
  }

  .panel__link,
  .panel__socials {
    margin-block: var(--space-md) var(--space-xs);
  }
</style>
<script>
  import { initDiagram } from '../scripts/nav-diagram';
  const root = document.querySelector<HTMLElement>('[data-diagram]');
  if (root) initDiagram(root);
</script>
