---
/* =========================================================================
   NavDiagram — the kinetic mind-map that *is* the site navigation.

   Markup is generated from `src/diagram.config.ts`. Nodes are real, focusable
   buttons (with links inside their reveal panels), so the diagram is keyboard-
   and screen-reader navigable. A small vanilla-JS spring simulation (below)
   gives the graph its "live molecule" give: edges behave like springs, the
   nodes repel when too close, and you can drag a node to tug the whole
   structure. Hovering / focusing / tapping a node calms it and reveals its
   panel. Everything degrades to a static, readable list without JS, and the
   simulation is skipped under `prefers-reduced-motion`.
   ========================================================================= */
import { diagramNodes, diagramEdges, type NodeShape } from '../diagram.config';
import { withBase } from '../lib/base';
import { site } from '../site.config';

// Node "points" are polygons (no circles). Compute the points string for a
// regular n-gon inscribed in a 20×20 viewBox, rotated to sit upright.
const SHAPE_SIDES: Record<NodeShape, number> = {
  triangle: 3,
  square: 4,
  pentagon: 5,
  hexagon: 6,
};
const SHAPE_ROT: Record<NodeShape, number> = {
  triangle: -90, // point up
  square: -45, // flat sides
  pentagon: -90, // point up
  hexagon: -90, // point top
};
function polygonPoints(shape: NodeShape = 'hexagon'): string {
  const sides = SHAPE_SIDES[shape] ?? 6;
  const rot = SHAPE_ROT[shape] ?? -90;
  const cx = 10;
  const cy = 10;
  const r = 8.4;
  const pts: string[] = [];
  for (let i = 0; i < sides; i++) {
    const a = ((rot + (i * 360) / sides) * Math.PI) / 180;
    pts.push(`${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`);
  }
  return pts.join(' ');
}

// Floating nodes have no polygon — only a label that wraps around their
// invisible centre point. Size a circular SVG path so the phrase wraps once
// around the ring with a small gap before the start (longer phrases → larger
// ring, keeping letter spacing even). The text is stretched to its natural
// length at render time — the extra arc stays empty.
const RING_FONT = 13; // SVG user units (= px, since the viewBox maps 1:1)
const RING_GAP_CHARS = 3.5; // empty arc between phrase end and start
function ringGeometry(label: string) {
  // Mono advance (~0.6em) plus the wide tracking applied to the label.
  const advance = RING_FONT * 0.6 + RING_FONT * 0.125;
  const textLength = Math.max(label.length * advance, 120);
  const pathLength = textLength + RING_GAP_CHARS * advance;
  const r = pathLength / (2 * Math.PI);
  const pad = RING_FONT * 1.25; // room for glyph height outside the path radius
  const size = Math.round(2 * (r + pad));
  const c = size / 2;
  // Start at the top (12 o'clock) and sweep clockwise, so the text reads
  // left-to-right across the top and curves around — matching the reference.
  const d = `M ${c} ${(c - r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(2 * r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(-2 * r).toFixed(2)}`;
  return { textLength: textLength.toFixed(2), size, d };
}

// Split the nodes so the markup mirrors the page's real outline: the identity
// node carries the page <h1>, the remaining single nodes are <h2> landmarks,
// and the case-study nodes are gathered into one labelled "Selected projects"
// group. Positioning is unchanged — nodes are absolutely placed by the
// simulation regardless of DOM nesting.
const projectNodes = diagramNodes.filter((n) => n.kind === 'project');
const floatingNodes = diagramNodes.filter((n) => n.kind === 'floating');
const otherNodes = diagramNodes.filter(
  (n) => n.kind !== 'project' && n.kind !== 'floating'
);
---

<nav class="diagram" data-diagram aria-label={`Site map — ${site.name}`}>
  <svg class="diagram__links" data-links aria-hidden="true" focusable="false"></svg>
  <ul class="diagram__edges-data" hidden>
    {
      diagramEdges.map(([a, b]) => (
        <li data-a={a} data-b={b} />
      ))
    }
  </ul>

  {
    otherNodes.map((node) => {
      const Heading = node.kind === 'identity' ? 'h1' : 'h2';
      const hasPanel = node.kind !== 'identity';
      return (
        <div
          class:list={['node', `node--${node.kind}`, `node--${node.size ?? 'md'}`]}
          data-node
          data-id={node.id}
          data-place={node.place ?? 'bottom'}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
        >
          <Heading class="node__heading">
            <button
              class="node__hit"
              type="button"
              {...(hasPanel
                ? { 'aria-expanded': 'false', 'aria-controls': `panel-${node.id}` }
                : {})}
            >
              <svg class="node__dot" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <polygon points={polygonPoints(node.shape)} />
              </svg>
              <span class="node__label">{node.label}</span>
              {node.subLabel && <span class="node__sublabel mono">{node.subLabel}</span>}
            </button>
          </Heading>

          {hasPanel && (
            <div class="node__panel" id={`panel-${node.id}`} role="group" aria-label={node.label}>
              {node.meta && <p class="panel__meta mono">{node.meta}</p>}
              {node.tagline && <p class="panel__lead">{node.tagline}</p>}
              {node.lines?.map((line) => <p class="panel__text">{line}</p>)}

              {node.metrics && (
                <ul class="panel__metrics" role="list">
                  {node.metrics.map((m) => (
                    <li class="panel__metric">
                      <span class="panel__metric-value">{m.value}</span>
                      <span class="panel__metric-label">{m.label}</span>
                    </li>
                  ))}
                </ul>
              )}

              {node.kind === 'contact' && (
                <ul class="panel__socials" role="list">
                  {site.socials.map((s) => (
                    <li>
                      <a
                        class="panel__social"
                        href={s.href}
                        rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                      >
                        {s.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              {node.email && (
                <a class="panel__link" href={`mailto:${node.email}`}>
                  {node.email}
                </a>
              )}

              {node.link && (
                <a
                  class="panel__link panel__cta"
                  href={node.link.external ? node.link.href : withBase(node.link.href)}
                  {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {node.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          )}
        </div>
      );
    })
  }

  <div class="node-group" role="group" aria-label="Selected projects">
    {
      projectNodes.map((node) => (
        <div
          class:list={['node', `node--${node.kind}`, `node--${node.size ?? 'md'}`]}
          data-node
          data-id={node.id}
          data-place={node.place ?? 'bottom'}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
        >
          <h2 class="node__heading">
            <button
              class="node__hit"
              type="button"
              aria-expanded="false"
              aria-controls={`panel-${node.id}`}
            >
              <svg class="node__dot" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <polygon points={polygonPoints(node.shape)} />
              </svg>
              <span class="node__label">{node.label}</span>
            </button>
          </h2>

          <div class="node__panel" id={`panel-${node.id}`} role="group" aria-label={node.label}>
            {node.meta && <p class="panel__meta mono">{node.meta}</p>}
            {node.tagline && <p class="panel__lead">{node.tagline}</p>}
            {node.lines?.map((line) => <p class="panel__text">{line}</p>)}

            {node.tags && (
              <ul class="panel__tags" role="list">
                {node.tags.map((t) => (
                  <li class="panel__chip">{t}</li>
                ))}
              </ul>
            )}

            {node.link && (
              <a
                class="panel__link panel__cta"
                href={node.link.external ? node.link.href : withBase(node.link.href)}
                {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {node.link.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>

  {
    floatingNodes.map((node) => {
      const ring = ringGeometry(node.label);
      return (
        <div
          class="node node--floating"
          data-node
          data-floating
          data-id={node.id}
          data-px={node.portrait.x}
          data-py={node.portrait.y}
          data-lx={node.landscape.x}
          data-ly={node.landscape.y}
          aria-hidden="true"
        >
          <svg
            class="node__ring"
            viewBox={`0 0 ${ring.size} ${ring.size}`}
            width={ring.size}
            height={ring.size}
            role="img"
            aria-label={node.label}
            focusable="false"
          >
            <defs>
              <path id={`ring-${node.id}`} d={ring.d} fill="none" />
            </defs>
            <text class="node__ring-text">
              <textPath
                href={`#ring-${node.id}`}
                startOffset="0"
                textLength={ring.textLength}
                lengthAdjust="spacingAndGlyphs"
              >
                {node.label}
              </textPath>
            </text>
          </svg>
        </div>
      );
    })
  }
</nav>

<noscript>
  <style>
    /* No-JS fallback: collapse the simulation into a plain, readable list. */
    .diagram {
      height: auto !important;
      min-height: 0 !important;
      padding: var(--space-xl) var(--gutter) !important;
    }
    .diagram__links {
      display: none !important;
    }
    .node {
      position: static !important;
      transform: none !important;
      display: block !important;
      max-width: 40rem;
      margin-inline: auto;
      margin-block-end: var(--space-lg);
    }
    .node__panel {
      position: static !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      pointer-events: auto !important;
      margin-block-start: var(--space-sm);
    }
  </style>
</noscript>

<style>
  .diagram {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    touch-action: pan-y;
  }

  .diagram__edges-data {
    display: none;
  }

  .diagram__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .diagram__links :global(.link-line) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    opacity: 0.42;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The "Selected projects" wrapper is purely a semantic grouping — it must
     not create a stacking context or take up layout, so the nodes inside it
     stay absolutely positioned against the diagram exactly as before. */
  .node-group {
    display: contents;
  }

  /* ----------------------------- Nodes ----------------------------- */
  .node {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    will-change: transform;
  }
  .node:hover,
  .node:focus-within,
  .node.is-open,
  .node.is-dragging {
    z-index: 6;
  }

  /* Heading wrappers give the page a real outline without changing the look:
     they wrap the existing button and inherit all typography from it. */
  .node__heading {
    display: inline-flex;
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-wrap: nowrap;
  }

  .node__hit {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .node.is-dragging .node__hit {
    cursor: grabbing;
  }

  .node__dot {
    width: 15px;
    height: 15px;
    overflow: visible;
    flex: none;
    transition: transform var(--dur-fast) var(--ease);
  }
  .node--lg .node__dot {
    width: 21px;
    height: 21px;
  }
  .node--sm .node__dot {
    width: 11px;
    height: 11px;
  }
  .node__dot polygon {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
    transition: fill var(--dur-fast) var(--ease),
      stroke var(--dur-fast) var(--ease);
  }
  .node--lg .node__dot polygon {
    stroke-width: 1.9;
  }
  .node__hit:hover .node__dot,
  .node:focus-within .node__dot,
  .node.is-open .node__dot {
    transform: scale(1.2);
  }
  .node__hit:hover .node__dot polygon,
  .node:focus-within .node__dot polygon,
  .node.is-open .node__dot polygon {
    fill: var(--accent);
    stroke: var(--accent-ink);
  }

  /* Knockout plate — a single solid paper-coloured box behind each label so
     connector lines are masked completely (no per-glyph gaps). Tune the cover
     with --ko-px / --ko-py (padding) and --ko-radius. --ko is the fill colour. */
  .node__label,
  .node__sublabel {
    --ko: var(--paper);
    --ko-px: 0.375em;
    --ko-py: 0;
    --ko-radius: var(--radius-sm);
    display: inline-block;
    padding: var(--ko-py) var(--ko-px);
    /* Cancel the padding's footprint so spacing/centering is unchanged. */
    margin: calc(-1 * var(--ko-py)) calc(-1 * var(--ko-px));
    background-color: var(--ko);
    border-radius: var(--ko-radius);
  }

  .node__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }
  .node__hit:hover .node__label,
  .node:focus-within .node__label,
  .node.is-open .node__label {
    color: var(--ink);
  }
  .node--identity .node__label {
    font-family: var(--font-sans);
    text-transform: none;
    letter-spacing: var(--tracking-tight);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink);
  }

  .node__sublabel {
    margin-block-start: 0.15rem;
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .node--identity .node__sublabel {
    color: var(--ink-2);
  }

  /* --------------------------- Floating nodes --------------------------- */
  /* Shapeless, line-less ambient labels that drift in the whitespace. They are
     decorative, so they never intercept pointer events (clicks fall through to
     the canvas) and are hidden from assistive tech at the container level. */
  .node--floating {
    pointer-events: none;
    z-index: 0;
  }
  .node__ring {
    display: block;
    overflow: visible;
    transform-origin: center;
  }
  @keyframes ring-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .node--floating .node__ring {
      animation: ring-spin 45s linear infinite;
    }
  }
  .node__ring-text {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    fill: var(--ink-2);
  }

  /* ----------------------------- Panel ----------------------------- */
  .node__panel {
    --shift: 8px;
    position: absolute;
    width: max-content;
    max-width: min(74vw, 19rem);
    padding: 0.85rem 1rem;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease),
      visibility var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .node--identity .node__panel {
    max-width: min(80vw, 22rem);
  }

  .node[data-place='bottom'] .node__panel {
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(var(--shift));
  }
  .node[data-place='top'] .node__panel {
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(calc(-1 * var(--shift)));
  }
  .node[data-place='right'] .node__panel {
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%) translateX(var(--shift));
  }
  .node[data-place='left'] .node__panel {
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%) translateX(calc(-1 * var(--shift)));
  }

  .node:hover .node__panel,
  .node:focus-within .node__panel,
  .node.is-open .node__panel {
    --shift: 0px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .panel__meta {
    color: var(--ink-3);
    margin-block-end: 0.35rem;
  }
  .panel__lead {
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--ink);
  }
  .node--about .panel__lead {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
  }
  .panel__text {
    margin-block-start: 0.5rem;
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--ink-2);
  }

  .panel__metrics {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    padding-block-start: 0.6rem;
    border-block-start: 1px solid var(--line);
  }
  .panel__metric {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
  }
  .panel__metric-value {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-ink);
    min-width: 4.2ch;
  }
  .panel__metric-label {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: 0.75rem;
  }
  .panel__chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--paper-2);
    color: var(--ink-2);
  }

  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    margin-block-start: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .panel__link:hover {
    color: var(--accent);
  }
  .panel__cta {
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }
  .panel__cta span {
    transition: transform var(--dur) var(--ease);
  }
  .panel__cta:hover span {
    transform: translateX(3px);
  }
</style>

<script>
  type Node = {
    el: HTMLElement;
    id: string;
    /** Layout position as a fraction (0..1) of the padded canvas. Regenerated
        randomly on each load / reset; updated when a node is dragged. */
    frac: { x: number; y: number };
    x: number;
    y: number;
    vx: number;
    vy: number;
    fx: number;
    fy: number;
    ax: number;
    ay: number;
    /** Vertical offset from the node's box centre to its polygon point, so
        connectors attach to the shape rather than crossing the label. */
    dotDy: number;
    /** Floating nodes are unconnected, shapeless ambient labels. They take part
        in collision / viewport avoidance but never in the chain or edge logic. */
    floating: boolean;
    calm: boolean;
    dragging: boolean;
    hover: boolean;
    focus: boolean;
  };

  type EdgeShape = {
    kind: 'straight' | 'jagged' | 'wave';
    /** Perpendicular offsets at fractional positions along the chord (t in 0..1).
        Endpoints (t=0 and t=1) are always 0 and added at render time. */
    points: { t: number; off: number }[];
  };

  function initDiagram(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('[data-links]');
    const edgeData = Array.from(
      root.querySelectorAll<HTMLElement>('.diagram__edges-data > li')
    );
    const nodeEls = Array.from(root.querySelectorAll<HTMLElement>('[data-node]'));
    if (!svg || !nodeEls.length) return;
    const svgEl: SVGSVGElement = svg;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SVG_NS = 'http://www.w3.org/2000/svg';

    const nodes: Node[] = nodeEls.map((el) => ({
      el,
      id: el.dataset.id || '',
      frac: { x: 0.5, y: 0.5 },
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      fx: 0,
      fy: 0,
      ax: 0,
      ay: 0,
      dotDy: 0,
      floating: el.dataset.floating !== undefined,
      calm: false,
      dragging: false,
      hover: false,
      focus: false,
    }));
    const byId = new Map(nodes.map((n) => [n.id, n]));

    const edges = edgeData
      .map((li) => {
        const a = byId.get(li.dataset.a || '');
        const b = byId.get(li.dataset.b || '');
        if (!a || !b) return null;
        const line = document.createElementNS(SVG_NS, 'path');
        line.setAttribute('class', 'link-line');
        line.setAttribute('fill', 'none');
        svgEl.appendChild(line);
        const shape: EdgeShape = { kind: 'straight', points: [] };
        return { a, b, line, rest: 0, shape };
      })
      .filter(Boolean) as {
      a: Node;
      b: Node;
      line: SVGPathElement;
      rest: number;
      shape: EdgeShape;
    }[];

    // Order the nodes along the chain (the diagram is one open line) so the
    // random walk lays them out sequentially and the connectors read as a line.
    const chainOrder: Node[] = (() => {
      const adj = new Map<string, string[]>();
      for (const e of edges) {
        (adj.get(e.a.id) || adj.set(e.a.id, []).get(e.a.id)!).push(e.b.id);
        (adj.get(e.b.id) || adj.set(e.b.id, []).get(e.b.id)!).push(e.a.id);
      }
      const ends = [...adj.keys()].filter((id) => (adj.get(id) || []).length === 1);
      if (!ends.length) return nodes.slice();
      const order: Node[] = [];
      const seen = new Set<string>();
      let cur: string | undefined = ends[0];
      while (cur && !seen.has(cur)) {
        seen.add(cur);
        const n = byId.get(cur);
        if (n) order.push(n);
        cur = (adj.get(cur) || []).find((id) => !seen.has(id));
      }
      // Append any stragglers (defensive: not a clean path). Floating nodes are
      // never part of the chain — they are laid out independently.
      for (const n of nodes) if (!seen.has(n.id) && !n.floating) order.push(n);
      return order;
    })();

    let W = 0;
    let H = 0;

    // --- Dynamic layout ------------------------------------------------------
    // Fresh random shape on each load / identity reset (Math.random, no seed).
    // Resize/crowding may nudge toward diagram.config coords only when adapting.
    /** How constrained the horizontal axis is. Returns a 0..1 value where
        higher = narrower (phone-portrait territory). Used to decide layout
        tilt, meander amplitude, label side, etc. */
    function narrowness() {
      const aspect = W / Math.max(1, H);
      // aspect 1.0 → 0 (square), aspect 0.5 → 1 (very tall phone)
      return Math.max(0, Math.min(1, (1 - aspect) / 0.5));
    }

    function inset() {
      const narrow = narrowness();
      // Labels are centered under the dot and extend ~110 px to each side, so
      // the *horizontal* margin must grow on narrow viewports or labels clip
      // at the screen edge. The vertical margin also gets a small boost so the
      // bottom-most label has room.
      const mx = Math.min((0.14 + 0.16 * narrow) * W, 180);
      const my = Math.min((0.12 + 0.06 * narrow) * H, 160);
      return { mx, my, iw: Math.max(1, W - 2 * mx), ih: Math.max(1, H - 2 * my) };
    }

    function configFrac(n: Node, landscape: boolean) {
      const el = n.el;
      const x = parseFloat(landscape ? el.dataset.lx || '0.5' : el.dataset.px || '0.5');
      const y = parseFloat(landscape ? el.dataset.ly || '0.5' : el.dataset.py || '0.5');
      return { x, y };
    }

    function clampFrac(x: number, y: number) {
      return {
        x: Math.max(0.08, Math.min(0.92, x)),
        y: Math.max(0.08, Math.min(0.92, y)),
      };
    }

    /** Blend spine sample with authored map coords so the graph can breathe. */
    function blendWithConfig(n: Node, landscape: boolean, spine: { x: number; y: number }, mix: number) {
      const cfg = configFrac(n, landscape);
      return clampFrac(spine.x * (1 - mix) + cfg.x * mix, spine.y * (1 - mix) + cfg.y * mix);
    }

    function generateLayout() {
      const rect = root.getBoundingClientRect();
      const landscape = rect.width > rect.height * 1.15;
      const n = chainOrder.length;
      // The chain advances monotonically along a spine (that's what keeps it
      // from folding into sharp switchbacks), but the spine's *direction* is
      // free: biased toward the dominant axis to use the canvas, with a wide
      // tilt and a random end-to-end flip so no node sits in the same "zone"
      // across reloads.
      const base = landscape ? 0 : Math.PI / 2;
      // Narrow viewports can't absorb tilt or meander without folding the
      // chain back on itself, so we shrink both as `narrow` → 1.
      const narrow = narrowness();
      const tiltDeg = 42 - 28 * narrow; // 42° → 14° as the viewport narrows
      const tilt = (Math.random() * 2 - 1) * (tiltDeg * Math.PI) / 180;
      const flip = Math.random() < 0.5 ? 1 : -1; // run the line either way
      const ang = base + tilt;
      const dx = Math.cos(ang) * flip;
      const dy = Math.sin(ang) * flip;
      const ox = -dy; // perpendicular axis
      const oy = dx;
      const cx = 0.42 + Math.random() * 0.16;
      const cy = 0.42 + Math.random() * 0.16;
      const half = 0.34 + Math.random() * 0.12;
      // Gentle, mean-reverting perpendicular meander: organic waviness around
      // the spine without ever turning back on itself. Amplitude/clamp shrink
      // on narrow viewports to keep the chain near the centerline.
      const meanderMax = 0.2 - 0.12 * narrow; // 0.2 → 0.08
      const velKick = 0.08 - 0.04 * narrow;
      const jitMax = 0.05 - 0.025 * narrow;
      let o = (Math.random() * 2 - 1) * 0.1 * (1 - 0.6 * narrow);
      let vel = 0;
      for (let i = 0; i < n; i++) {
        const s = (n === 1 ? 0 : i / (n - 1) - 0.5) * 2 * half;
        vel += (Math.random() * 2 - 1) * velKick;
        vel -= o * 0.22; // pull back toward the spine (mean reversion)
        vel *= 0.58;
        o += vel;
        o = Math.max(-meanderMax, Math.min(meanderMax, o));
        const alongJit = (Math.random() * 2 - 1) * jitMax;
        const perpJit = (Math.random() * 2 - 1) * jitMax;
        const spine = clampFrac(
          cx + dx * s + ox * (o + perpJit) + dx * alongJit,
          cy + dy * s + oy * (o + perpJit) + dy * alongJit
        );
        // Low config blend: a faint nudge toward the authored map, not a pin —
        // keeps the form free and varied between loads.
        chainOrder[i].frac = blendWithConfig(chainOrder[i], landscape, spine, 0.12);
      }
      // Floating nodes aren't part of the spine. Scatter them across the canvas
      // (lightly nudged toward their authored hint) and let relaxAnchors + the
      // sim's repulsion drift them into open whitespace without overlapping.
      for (const n of nodes) {
        if (!n.floating) continue;
        const rnd = clampFrac(0.1 + Math.random() * 0.8, 0.1 + Math.random() * 0.8);
        n.frac = blendWithConfig(n, landscape, rnd, 0.25);
      }
    }

    // Connectors are straight, jagged, or (1 in 5) a tight wavy line.
    function generateEdgeShapes() {
      const kinds = pickKindDistribution(edges.length);
      shuffleInPlace(kinds);
      for (let i = 0; i < edges.length; i++) {
        if (kinds[i] === 'jagged') edges[i].shape = { kind: 'jagged', points: makeJaggedPoints() };
        else if (kinds[i] === 'wave') edges[i].shape = { kind: 'wave', points: makeWavePoints() };
        else edges[i].shape = { kind: 'straight', points: [] };
      }
    }

    function shuffleInPlace<T>(arr: T[]) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
    }

    /** Pick how many of each kind appear in this layout.
        For 5 edges: exactly 1 wave, 2–3 jagged, the rest straight. */
    function pickKindDistribution(n: number): Array<'straight' | 'jagged' | 'wave'> {
      if (n === 5) {
        const options: Array<[number, number, number]> = [
          [2, 2, 1], // 2 straight, 2 jagged, 1 wave
          [1, 3, 1], // 1 straight, 3 jagged, 1 wave
        ];
        const [s, j, w] = options[Math.floor(Math.random() * options.length)];
        return [
          ...Array(s).fill('straight' as const),
          ...Array(j).fill('jagged' as const),
          ...Array(w).fill('wave' as const),
        ];
      }
      // Generic fallback: ~1-in-5 wave, roughly half jagged, rest straight.
      const w = Math.max(0, Math.round(n / 5));
      const j = Math.max(1, Math.min(n - w, Math.round(n * 0.4)));
      const s = Math.max(0, n - j - w);
      return [
        ...Array(s).fill('straight' as const),
        ...Array(j).fill('jagged' as const),
        ...Array(w).fill('wave' as const),
      ];
    }

    /** A pure-sine wavy line: 3–5 ripples, amplitude 6–14px, perfectly regular.
        The points array encodes the wave parameters for the renderer:
        `points.length` = number of humps, `|points[0].off|` = peak amplitude. */
    function makeWavePoints(): { t: number; off: number }[] {
      const count = 4 + Math.floor(Math.random() * 3); // No. of humps
      const amp = 10 + Math.random() * 10; // Width of humps
      const sign = Math.random() < 0.5 ? 1 : -1;
      const pts: { t: number; off: number }[] = [];
      for (let k = 0; k < count; k++) {
        // Hump centres evenly spaced along the chord with equal amplitude —
        // the renderer reconstructs the actual sine curve from these values.
        const t = (k + 0.5) / count;
        const dir = k % 2 === 0 ? sign : -sign;
        pts.push({ t, off: dir * amp });
      }
      return pts;
    }

    /** Tight jagged line — 2–3 corners, narrow consistent zig-zag width.
        Inspired by the diagrammatic line work on andrewtrousdale.com: short
        amplitude, even spacing, strict alternation, near-uniform peaks so each
        line reads as a clean pulse rather than a chaotic squiggle. */
    function makeJaggedPoints(): { t: number; off: number }[] {
      const count = 2 + Math.floor(Math.random() * 2); // No. of corners
      const baseAmp = 12 + Math.random() * 14; // Width of the zig-zags
      let sign = Math.random() < 0.5 ? 1 : -1;
      const pts: { t: number; off: number }[] = [];
      for (let k = 0; k < count; k++) {
        const center = (k + 1) / (count + 1);
        // Small position jitter so corners aren't perfectly metronomic, but
        // not enough to look chaotic.
        const tJit = ((Math.random() * 2 - 1) * 1.25) / (count + 1);
        // Near-uniform amplitude per spike — keeps the pulse consistent.
        const ampScale = 0.9 + Math.random() * 0.2; // 0.9..1.1
        pts.push({
          t: Math.max(0.08, Math.min(0.92, center + tJit)),
          off: sign * baseAmp * ampScale,
        });
        sign = -sign; // strict alternation — clean back-and-forth
      }
      return pts;
    }

    // Measure each node's polygon-point offset from its box centre (once the
    // labels are laid out), so connectors meet the shape, not the text.
    function measureDotOffsets() {
      for (const n of nodes) {
        const dot = n.el.querySelector('.node__dot');
        if (!dot) continue;
        const nr = n.el.getBoundingClientRect();
        const dr = dot.getBoundingClientRect();
        n.dotDy = dr.top + dr.height / 2 - (nr.top + nr.height / 2);
      }
    }

    function nodeExtent(n: Node) {
      const r = n.el.getBoundingClientRect();
      return Math.max(r.width, r.height, 96) * 0.68;
    }

    /** Minimum centre-to-centre distance for two nodes to feel uncrowded. */
    function minSeparation(a: Node, b: Node) {
      const PAD = 110;
      return nodeExtent(a) + nodeExtent(b) + PAD;
    }

    /** Iteratively push anchor fractions apart so initial layout is uncrowded
        before the sim starts (otherwise a weak repulsion can settle on overlap). */
    function relaxAnchors(iterations = 80) {
      const { mx, my, iw, ih } = inset();
      if (iw < 2 || ih < 2) return;
      const px = nodes.map((n) => mx + n.frac.x * iw);
      const py = nodes.map((n) => my + n.frac.y * ih);
      for (let it = 0; it < iterations; it++) {
        let moved = 0;
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            let dx = px[j] - px[i];
            let dy = py[j] - py[i];
            const d = Math.hypot(dx, dy) || 0.01;
            const minD = minSeparation(nodes[i], nodes[j]);
            if (d >= minD) continue;
            const overlap = (minD - d) * 0.5;
            const ux = dx / d;
            const uy = dy / d;
            px[i] -= ux * overlap;
            py[i] -= uy * overlap;
            px[j] += ux * overlap;
            py[j] += uy * overlap;
            moved = Math.max(moved, overlap);
          }
        }
        for (let i = 0; i < nodes.length; i++) {
          px[i] = Math.max(mx + 6, Math.min(mx + iw - 6, px[i]));
          py[i] = Math.max(my + 6, Math.min(my + ih - 6, py[i]));
        }
        if (moved < 0.3) break;
      }
      for (let i = 0; i < nodes.length; i++) {
        nodes[i].frac = clampFrac((px[i] - mx) / iw, (py[i] - my) / ih);
      }
    }

    /** Open up acute interior corners in the chain path. For each non-endpoint
        chain node we compute the angle between the vectors going OUT to its
        previous and next neighbours. cos = +1 means both legs go the same way
        (worst, very acute), cos = 0 means a right angle, cos = -1 means
        a perfectly straight path. We nudge any node whose cos > `cosLimit`
        toward the midpoint of its neighbours to open the corner. Re-run
        `relaxAnchors` afterwards to restore separation. */
    function straightenAngles(iterations = 20, cosLimit = -0.15) {
      const { mx, my, iw, ih } = inset();
      if (iw < 2 || ih < 2) return;
      const order = chainOrder;
      if (order.length < 3) return;
      for (let it = 0; it < iterations; it++) {
        let maxAdj = 0;
        for (let i = 1; i < order.length - 1; i++) {
          const p = order[i - 1];
          const c = order[i];
          const nx = order[i + 1];
          const v1x = p.ax - c.ax;
          const v1y = p.ay - c.ay;
          const v2x = nx.ax - c.ax;
          const v2y = nx.ay - c.ay;
          const len1 = Math.hypot(v1x, v1y) || 1;
          const len2 = Math.hypot(v2x, v2y) || 1;
          const cos = (v1x * v2x + v1y * v2y) / (len1 * len2);
          if (cos <= cosLimit) continue;
          // Pull `c` toward the midpoint of `p` and `nx` to straighten the bend.
          const midX = (p.ax + nx.ax) / 2;
          const midY = (p.ay + nx.ay) / 2;
          // Stronger pull when the corner is more acute (cos closer to +1).
          const urgency = Math.min(1, (cos - cosLimit) / (1 - cosLimit));
          const k = 0.12 + 0.18 * urgency;
          const newX = Math.max(mx + 6, Math.min(mx + iw - 6, c.ax + (midX - c.ax) * k));
          const newY = Math.max(my + 6, Math.min(my + ih - 6, c.ay + (midY - c.ay) * k));
          const adj = Math.hypot(newX - c.ax, newY - c.ay);
          c.ax = newX;
          c.ay = newY;
          c.frac = clampFrac((newX - mx) / iw, (newY - my) / ih);
          maxAdj = Math.max(maxAdj, adj);
        }
        if (maxAdj < 0.5) break;
      }
    }

    function isLandscape() {
      return W > H * 1.15;
    }

    function layoutIsCrowded() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          if (Math.hypot(a.ax - b.ax, a.ay - b.ay) < minSeparation(a, b) * 0.92) return true;
        }
      }
      return false;
    }

    /** Re-space when crowded — random meander; light config hint only on resize. */
    function adaptLayoutForViewport(landscape: boolean) {
      const n = chainOrder.length;
      const margin = 0.08;
      const narrow = narrowness();
      const phase = Math.random() * Math.PI * 2;
      const perpBase = (Math.random() * 2 - 1) * 0.2 * (1 - 0.6 * narrow);
      const velKick = 0.18 - 0.12 * narrow;
      const waveAmp = (0.22 + Math.random() * 0.14) * (1 - 0.55 * narrow);
      const perpClamp = 0.48 - 0.32 * narrow; // 0.48 → 0.16 on narrow
      let o = perpBase;
      let vel = 0;
      for (let i = 0; i < n; i++) {
        const t = n === 1 ? 0.5 : i / (n - 1);
        const along = margin + t * (1 - 2 * margin);
        vel += (Math.random() * 2 - 1) * velKick;
        vel *= 0.62;
        o += vel;
        const wave = Math.sin(t * Math.PI * 1.35 + phase) * waveAmp;
        const perp = Math.max(-perpClamp, Math.min(perpClamp, o + wave));
        const spine = landscape
          ? { x: along, y: 0.5 + perp }
          : { x: 0.5 + perp, y: along };
        chainOrder[i].frac = blendWithConfig(chainOrder[i], landscape, spine, 0.18);
      }
    }

    function syncAnchorsFromSim() {
      const { mx, my, iw, ih } = inset();
      for (const n of nodes) {
        if (n.dragging) continue;
        n.ax = n.x;
        n.ay = n.y;
        n.frac = {
          x: Math.max(0, Math.min(1, (n.x - mx) / iw)),
          y: Math.max(0, Math.min(1, (n.y - my) / ih)),
        };
        n.el.dataset.place = placeFor(n);
      }
      recomputeRests();
    }

    // Build the SVG path for an edge from its current endpoints + its shape.
    function edgePath(e: { a: Node; b: Node; shape: EdgeShape; liveSpikes?: { x: number; y: number; vx: number; vy: number }[] | null }): string {
      const ax = e.a.x;
      const ay = e.a.y + e.a.dotDy;
      const bx = e.b.x;
      const by = e.b.y + e.b.dotDy;
      const dx = bx - ax;
      const dy = by - ay;
      const len = Math.hypot(dx, dy) || 1;
      const s = e.shape;
      if (s.kind === 'straight' || len < 4) return `M ${ax} ${ay} L ${bx} ${by}`;

      const nx = -dy / len;
      const ny = dx / len;
      // Build the waypoint list anchored at both ends so the path starts at A
      // and ends at B regardless of how many humps/spikes it has. Sort by t
      // defensively — out-of-order points would produce visible kinks.
      const sorted = s.points.slice().sort((p, q) => p.t - q.t);
      const wp = [{ t: 0, off: 0 }, ...sorted, { t: 1, off: 0 }];

      if (s.kind === 'wave') {
        // Pure sine wave along the chord — mathematical and stable. The waypoint
        // array carries the parameters: count = humps, |off| = amplitude, and
        // the sign of points[0].off picks the starting side. Endpoints are
        // exact zeros (sin(0) = sin(N·π) = 0) so the curve meets the nodes
        // cleanly without phantom-control hacks.
        const waves = s.points.length;
        const amp = Math.abs(s.points[0].off);
        const phase = s.points[0].off >= 0 ? 0 : Math.PI;
        const segs = Math.max(48, waves * 18);
        let wd = `M ${ax.toFixed(1)} ${ay.toFixed(1)}`;
        for (let i = 1; i <= segs; i++) {
          const t = i / segs;
          const off = Math.sin(t * Math.PI * waves + phase) * amp;
          const x = ax + dx * t + nx * off;
          const y = ay + dy * t + ny * off;
          wd += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        return wd;
      }

      // Jagged: sharp corners between waypoints — linear segments only.
      // Each corner is a live joint (e.liveSpikes), so its position lags the
      // rest target with damping and the line articulates like an arm.
      let d = `M ${ax.toFixed(1)} ${ay.toFixed(1)}`;
      const spikes = e.liveSpikes;
      if (spikes && spikes.length === s.points.length) {
        const indexed = s.points
          .map((p, i) => ({ i, t: p.t }))
          .sort((p, q) => p.t - q.t);
        for (const { i } of indexed) {
          const sp = spikes[i];
          d += ` L ${sp.x.toFixed(1)} ${sp.y.toFixed(1)}`;
        }
      } else {
        for (let i = 1; i < wp.length - 1; i++) {
          const x = ax + dx * wp[i].t + nx * wp[i].off;
          const y = ay + dy * wp[i].t + ny * wp[i].off;
          d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
        }
      }
      d += ` L ${bx.toFixed(1)} ${by.toFixed(1)}`;
      return d;
    }

    function recomputeRests() {
      for (const e of edges) {
        e.rest = Math.hypot(e.a.ax - e.b.ax, e.a.ay - e.b.ay);
      }
    }

    /** Closest point on segment a→b to point (px,py), plus the distance. */
    function closestPointOnSeg(
      px: number, py: number,
      a: { x: number; y: number }, b: { x: number; y: number },
    ) {
      const vx = b.x - a.x;
      const vy = b.y - a.y;
      const wx = px - a.x;
      const wy = py - a.y;
      const c1 = vx * wx + vy * wy;
      if (c1 <= 0) return { x: a.x, y: a.y, d: Math.hypot(px - a.x, py - a.y) };
      const c2 = vx * vx + vy * vy;
      if (c2 <= c1) return { x: b.x, y: b.y, d: Math.hypot(px - b.x, py - b.y) };
      const t = c1 / c2;
      const x = a.x + t * vx;
      const y = a.y + t * vy;
      return { x, y, d: Math.hypot(px - x, py - y) };
    }

    /** Nudge floating-node anchors out of the connector lines (and away from
        other nodes) so the ambient labels settle in clear whitespace rather than
        sitting on top of an edge. Edges only depend on the connected nodes'
        anchors, so the polylines are fixed during this relaxation — run it once
        the edge routing is final (after de-crossing). */
    function relaxFloatingFromEdges(iterations = 60) {
      const floats = nodes.filter((n) => n.floating);
      if (!floats.length || !edges.length) return;
      const { mx, my, iw, ih } = inset();
      if (iw < 2 || ih < 2) return;
      const polys = edges.map(edgePolyline);
      for (let it = 0; it < iterations; it++) {
        let moved = 0;
        for (const n of floats) {
          const clear = nodeExtent(n);
          let pushX = 0;
          let pushY = 0;
          let hit = false;
          for (const poly of polys) {
            for (let i = 0; i < poly.length - 1; i++) {
              const c = closestPointOnSeg(n.ax, n.ay, poly[i], poly[i + 1]);
              if (c.d >= clear) continue;
              const dx = n.ax - c.x;
              const dy = n.ay - c.y;
              const dd = Math.hypot(dx, dy) || 0.01;
              const overlap = clear - c.d;
              pushX += (dx / dd) * overlap;
              pushY += (dy / dd) * overlap;
              hit = true;
            }
          }
          for (const o of nodes) {
            if (o === n) continue;
            const dx = n.ax - o.ax;
            const dy = n.ay - o.ay;
            const dd = Math.hypot(dx, dy) || 0.01;
            const minD = minSeparation(n, o);
            if (dd >= minD) continue;
            const overlap = (minD - dd) * 0.5;
            pushX += (dx / dd) * overlap;
            pushY += (dy / dd) * overlap;
            hit = true;
          }
          if (!hit) continue;
          n.ax = Math.max(mx + 6, Math.min(mx + iw - 6, n.ax + pushX * 0.5));
          n.ay = Math.max(my + 6, Math.min(my + ih - 6, n.ay + pushY * 0.5));
          moved = Math.max(moved, Math.hypot(pushX, pushY));
        }
        if (moved < 0.5) break;
      }
      for (const n of floats) {
        n.frac = clampFrac((n.ax - mx) / iw, (n.ay - my) / ih);
        n.el.dataset.place = placeFor(n);
      }
    }

    /** Cheap segment-intersection test for two line segments. */
    function segmentsCross(
      ax: number, ay: number, bx: number, by: number,
      cx: number, cy: number, dx: number, dy: number,
    ): boolean {
      const r1 = bx - ax;
      const r2 = by - ay;
      const s1 = dx - cx;
      const s2 = dy - cy;
      const den = r1 * s2 - r2 * s1;
      if (Math.abs(den) < 1e-6) return false;
      const t = ((cx - ax) * s2 - (cy - ay) * s1) / den;
      const u = ((cx - ax) * r2 - (cy - ay) * r1) / den;
      return t > 0 && t < 1 && u > 0 && u < 1;
    }

    /** Swap the anchor positions of two nodes (positions only, not identities)
        so labels and panels stay tied to the same node — only the layout slot
        each node occupies changes. */
    function swapNodeAnchors(a: Node, b: Node) {
      const tAx = a.ax, tAy = a.ay, tFx = a.frac.x, tFy = a.frac.y;
      a.ax = b.ax; a.ay = b.ay; a.frac = { x: b.frac.x, y: b.frac.y };
      b.ax = tAx; b.ay = tAy; b.frac = { x: tFx, y: tFy };
      a.el.dataset.place = placeFor(a);
      b.el.dataset.place = placeFor(b);
    }

    /** Sample an edge as a polyline matching the rendered path, so we can
        test the actual curve (not just the chord) for crossings. */
    function edgePolyline(e: { a: Node; b: Node; shape: EdgeShape }): { x: number; y: number }[] {
      const ax = e.a.ax;
      const ay = e.a.ay + e.a.dotDy;
      const bx = e.b.ax;
      const by = e.b.ay + e.b.dotDy;
      const dx = bx - ax;
      const dy = by - ay;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;
      const sorted = e.shape.points.slice().sort((p, q) => p.t - q.t);
      const wp = [{ t: 0, off: 0 }, ...sorted, { t: 1, off: 0 }];
      const pts: { x: number; y: number }[] = [];
      if (e.shape.kind === 'straight' || wp.length === 2) {
        pts.push({ x: ax, y: ay }, { x: bx, y: by });
        return pts;
      }
      for (const p of wp) {
        pts.push({ x: ax + dx * p.t + nx * p.off, y: ay + dy * p.t + ny * p.off });
      }
      return pts;
    }

    /** Count intersections between two polylines (each a list of points). */
    function countPolylineCrossings(a: { x: number; y: number }[], b: { x: number; y: number }[]) {
      let n = 0;
      for (let i = 0; i < a.length - 1; i++) {
        for (let j = 0; j < b.length - 1; j++) {
          if (segmentsCross(
            a[i].x, a[i].y, a[i + 1].x, a[i + 1].y,
            b[j].x, b[j].y, b[j + 1].x, b[j + 1].y,
          )) n++;
        }
      }
      return n;
    }

    /** Total polyline crossings between all non-adjacent edge pairs. */
    function totalCurveCrossings(): number {
      const polys = edges.map(edgePolyline);
      let n = 0;
      for (let i = 0; i < edges.length; i++) {
        for (let j = i + 1; j < edges.length; j++) {
          const ei = edges[i];
          const ej = edges[j];
          if (ei.a === ej.a || ei.a === ej.b || ei.b === ej.a || ei.b === ej.b) continue;
          n += countPolylineCrossings(polys[i], polys[j]);
        }
      }
      return n;
    }

    /** For each curvy edge, try flipping its waypoint signs and keep the flip
        only if it reduces the total crossing count. Catches curve-vs-chord and
        curve-vs-curve overlaps that the chord-based 2-opt swap can't see. */
    function refineCurveCrossings() {
      for (let pass = 0; pass < 3; pass++) {
        let improved = false;
        let best = totalCurveCrossings();
        if (best === 0) return;
        for (const e of edges) {
          if (e.shape.points.length === 0) continue;
          for (const p of e.shape.points) p.off = -p.off;
          const candidate = totalCurveCrossings();
          if (candidate < best) {
            best = candidate;
            improved = true;
          } else {
            for (const p of e.shape.points) p.off = -p.off;
          }
          if (best === 0) return;
        }
        if (!improved) break;
      }
    }

    /** TSP-style 2-opt de-crossing for the chain graph. When non-adjacent
        edges' chords cross, reverse the anchor positions of the chain segment
        between them — this provably reduces total crossings on an open chain. */
    function decrossEdges() {
      const order = chainOrder;
      const safety = 12;
      for (let pass = 0; pass < safety; pass++) {
        let improved = false;
        // Edges in chain order: edge i connects order[i] and order[i+1].
        for (let i = 0; i < order.length - 1; i++) {
          for (let j = i + 2; j < order.length - 1; j++) {
            const a1 = order[i];
            const a2 = order[i + 1];
            const b1 = order[j];
            const b2 = order[j + 1];
            // Share a node? Then they're adjacent — can't cross meaningfully.
            if (a1 === b1 || a1 === b2 || a2 === b1) continue;
            if (!segmentsCross(
              a1.ax, a1.ay, a2.ax, a2.ay,
              b1.ax, b1.ay, b2.ax, b2.ay,
            )) continue;
            // Reverse anchor positions of order[i+1..j]. Edges between them
            // are unchanged topologically; geometrically they untangle.
            let lo = i + 1;
            let hi = j;
            while (lo < hi) {
              swapNodeAnchors(order[lo], order[hi]);
              lo++;
              hi--;
            }
            improved = true;
          }
        }
        if (!improved) break;
      }
      recomputeRests();
    }

    function placeFor(n: Node): string {
      const right = W - n.ax;
      const left = n.ax;
      const top = n.ay;
      const bottom = H - n.ay;
      // Approximate label box size we'd like to clear on each side.
      const needH = 220;
      const needV = 80;
      const narrow = narrowness();
      // On narrow viewports, horizontal placements are likely to crop labels.
      // Bias scores so top/bottom win unless side has truly generous space.
      const vBoost = 80 * narrow;
      const opts: [string, number][] = [
        ['right', right - needH],
        ['left', left - needH],
        ['bottom', bottom - needV + vBoost],
        ['top', top - needV + vBoost],
      ];
      opts.sort((p, q) => q[1] - p[1]);
      return opts[0][0];
    }

    // Map the stored fractions to pixel anchors for the current size. A resize
    // only remaps (no re-randomising), so the chosen shape is preserved.
    function computeAnchors(first = false) {
      const rect = root.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      svgEl.setAttribute('width', String(W));
      svgEl.setAttribute('height', String(H));
      const { mx, my, iw, ih } = inset();
      for (const n of nodes) {
        n.ax = mx + n.frac.x * iw;
        n.ay = my + n.frac.y * ih;
        if (first) {
          n.x = n.ax + (Math.random() - 0.5) * SIM.initialScatter;
          n.y = n.ay + (Math.random() - 0.5) * SIM.initialScatter;
        }
        n.el.dataset.place = placeFor(n);
      }
      recomputeRests();
    }

    // A fresh random shape: new positions + new connector styles, animated to.
    function resetLayout() {
      generateLayout();
      generateEdgeShapes();
      computeAnchors();
      relaxAnchors();
      computeAnchors();
      straightenAngles();
      relaxAnchors();
      computeAnchors();
      decrossEdges();
      refineCurveCrossings();
      relaxFloatingFromEdges();
      wake();
    }

    function render() {
      for (const n of nodes) {
        n.el.style.transform = `translate(${n.x}px, ${n.y}px) translate(-50%, -50%)`;
      }
      for (const e of edges) {
        e.line.setAttribute('d', edgePath(e));
      }
    }

    // Soft, overdamped motion — slow drift home, gentle edge give, no bounce.
    const SIM = {
      drag: 0.6,
      anchorPull: 0.05,
      edge: 0.01,
      repel: 0.1,
      calmPull: 0.12,
      settleMotion: 0.04,
      settleFrames: 10,
      initialScatter: 8,
    };

    // The simulation only runs while there is something to resolve — settling
    // after load, a resize, or a drag. Once everything is at rest it sleeps.
    let raf = 0;
    let running = false;
    let settledFrames = 0;

    function wake() {
      settledFrames = 0;
      if (!running) {
        running = true;
        raf = requestAnimationFrame(frame);
      }
    }

    function frame() {
      for (const n of nodes) {
        n.fx = 0;
        n.fy = 0;
      }
      for (const e of edges) {
        const dx = e.b.x - e.a.x;
        const dy = e.b.y - e.a.y;
        const d = Math.hypot(dx, dy) || 1;
        const f = (d - e.rest) * SIM.edge;
        const ux = (dx / d) * f;
        const uy = (dy / d) * f;
        e.a.fx += ux;
        e.a.fy += uy;
        e.b.fx -= ux;
        e.b.fy -= uy;
      }

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          let dx = b.x - a.x;
          let dy = b.y - a.y;
          const d = Math.hypot(dx, dy) || 1;
          const minD = minSeparation(a, b);
          if (d >= minD) continue;
          const push = ((minD - d) / d) * SIM.repel;
          dx = (dx / d) * push;
          dy = (dy / d) * push;
          if (!a.dragging) {
            a.fx -= dx;
            a.fy -= dy;
          }
          if (!b.dragging) {
            b.fx += dx;
            b.fy += dy;
          }
        }
      }

      let maxMotion = 0;
      let anyDragging = false;
      for (const n of nodes) {
        if (n.dragging) {
          anyDragging = true;
          continue;
        }
        if (n.calm) {
          const mx = n.ax - n.x;
          const my = n.ay - n.y;
          n.x += mx * SIM.calmPull;
          n.y += my * SIM.calmPull;
          n.vx = 0;
          n.vy = 0;
          maxMotion = Math.max(maxMotion, Math.abs(mx) + Math.abs(my));
          continue;
        }
        const tx = n.ax;
        const ty = n.ay;
        const homeX = tx - n.x;
        const homeY = ty - n.y;
        // Anchor: direct overdamped drift (no spring overshoot).
        n.x += homeX * SIM.anchorPull;
        n.y += homeY * SIM.anchorPull;
        // Edges / neighbours: low-energy ripple through velocity only.
        n.vx = (n.vx + n.fx) * SIM.drag;
        n.vy = (n.vy + n.fy) * SIM.drag;
        n.x += n.vx;
        n.y += n.vy;
        maxMotion = Math.max(
          maxMotion,
          Math.abs(n.vx) +
            Math.abs(n.vy) +
            Math.abs(homeX) * SIM.anchorPull +
            Math.abs(homeY) * SIM.anchorPull
        );
      }
      render();

      if (anyDragging) {
        settledFrames = 0;
        raf = requestAnimationFrame(frame);
        return;
      }
      settledFrames = maxMotion < SIM.settleMotion ? settledFrames + 1 : 0;
      if (settledFrames >= SIM.settleFrames) {
        syncAnchorsFromSim();
        for (const n of nodes) {
          n.vx = 0;
          n.vy = 0;
        }
        render();
        running = false;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function setCalm(n: Node) {
      n.calm = n.hover || n.focus || n.el.classList.contains('is-open');
    }
    function setOpen(n: Node, open: boolean) {
      n.el.classList.toggle('is-open', open);
      n.el
        .querySelector('.node__hit')
        ?.setAttribute('aria-expanded', open ? 'true' : 'false');
      setCalm(n);
      wake();
    }
    function closeAll(except?: Node) {
      for (const n of nodes) if (n !== except) setOpen(n, false);
    }

    // Close panels when clicking empty canvas.
    root.addEventListener('pointerdown', (ev) => {
      if (!(ev.target as HTMLElement).closest('[data-node]')) closeAll();
    });
    root.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') closeAll();
    });

    // Per-node interaction: hover/focus calming, drag, and tap-to-toggle.
    for (const n of nodes) {
      const hit = n.el.querySelector<HTMLButtonElement>('.node__hit');
      if (!hit) continue;

      n.el.addEventListener('pointerenter', () => {
        n.hover = true;
        setCalm(n);
        wake();
      });
      n.el.addEventListener('pointerleave', () => {
        n.hover = false;
        setCalm(n);
        wake();
      });
      n.el.addEventListener('focusin', () => {
        n.focus = true;
        setCalm(n);
        wake();
      });
      n.el.addEventListener('focusout', () => {
        n.focus = false;
        setCalm(n);
        wake();
      });

      let downX = 0;
      let downY = 0;
      let moved = false;
      let pid: number | null = null;

      hit.addEventListener('pointerdown', (ev) => {
        if (reduce) return;
        pid = ev.pointerId;
        downX = ev.clientX;
        downY = ev.clientY;
        moved = false;
        try {
          hit.setPointerCapture(pid);
        } catch {}
        wake();
      });
      hit.addEventListener('pointermove', (ev) => {
        if (pid === null) return;
        const dx = ev.clientX - downX;
        const dy = ev.clientY - downY;
        if (!moved && Math.hypot(dx, dy) > 6) {
          moved = true;
          n.dragging = true;
          n.el.classList.add('is-dragging');
        }
        if (n.dragging) {
          const r = root.getBoundingClientRect();
          n.x = ev.clientX - r.left;
          n.y = ev.clientY - r.top;
          n.vx = 0;
          n.vy = 0;
          wake();
        }
      });
      const endDrag = () => {
        if (pid === null) return;
        try {
          hit.releasePointerCapture(pid);
        } catch {}
        pid = null;
        if (n.dragging) {
          n.dragging = false;
          n.el.classList.remove('is-dragging');
          // Pin the node where it was dropped: store it as a fraction so it
          // settles there and survives resizes, and re-settle edge springs.
          const { mx, my, iw, ih } = inset();
          n.frac = {
            x: Math.max(0, Math.min(1, (n.x - mx) / iw)),
            y: Math.max(0, Math.min(1, (n.y - my) / ih)),
          };
          n.ax = n.x;
          n.ay = n.y;
          recomputeRests();
          n.el.dataset.place = placeFor(n);
          decrossEdges();
          refineCurveCrossings();
          wake();
        }
      };
      hit.addEventListener('pointerup', endDrag);
      hit.addEventListener('pointercancel', endDrag);

      hit.addEventListener('click', (ev) => {
        if (moved) {
          ev.preventDefault();
          return;
        }
        // Identity node only resets the layout — no reveal panel.
        if (n.id === 'pedro') {
          resetLayout();
          closeAll();
          return;
        }
        const wasOpen = n.el.classList.contains('is-open');
        closeAll(n);
        setOpen(n, !wasOpen);
      });
    }

    // Resize: remap anchors; re-space along the dominant axis when crowded or
    // when the viewport flips between portrait and landscape.
    let resizeScheduled = false;
    let lastLandscape: boolean | null = null;
    const onResize = () => {
      if (resizeScheduled) return;
      resizeScheduled = true;
      requestAnimationFrame(() => {
        resizeScheduled = false;
        computeAnchors();
        const landscape = isLandscape();
        const orientChanged = lastLandscape !== null && lastLandscape !== landscape;
        lastLandscape = landscape;
        if (orientChanged || layoutIsCrowded()) {
          adaptLayoutForViewport(landscape);
          computeAnchors();
        }
        measureDotOffsets();
        relaxAnchors();
        computeAnchors();
        straightenAngles();
        relaxAnchors();
        computeAnchors();
        decrossEdges();
        refineCurveCrossings();
        relaxFloatingFromEdges();
        wake();
      });
    };
    const ro = new ResizeObserver(onResize);
    ro.observe(root);

    generateLayout();
    generateEdgeShapes();
    computeAnchors(true);
    lastLandscape = isLandscape();
    measureDotOffsets();
    // After measuring labels, enforce safety distance so anchors start uncrowded.
    relaxAnchors();
    computeAnchors();
    straightenAngles();
    relaxAnchors();
    computeAnchors();
    decrossEdges();
    refineCurveCrossings();
    relaxFloatingFromEdges();
    render();

    if (reduce) {
      for (const n of nodes) {
        n.x = n.ax;
        n.y = n.ay;
      }
      render();
      return;
    }

    // Settle from the initial scattered positions, then sleep.
    wake();

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
        running = false;
      } else {
        wake();
      }
    });
  }

  const root = document.querySelector<HTMLElement>('[data-diagram]');
  if (root) initDiagram(root);
</script>
