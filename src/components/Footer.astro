---
import { site } from '../site.config';
---

<footer data-reveal>
  <div>
    <ul role="list">
      {site.socials.map((s) => (
        <li><a href={s.href} data-email={s.token}>{s.label}</a></li>
      ))}
    </ul>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  /* The rule sits on the inner box so it lines up with the text column rather
     than running out into the gutters. */

  div {
    border-block-start: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  p {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--ink-3);
  }
</style>
