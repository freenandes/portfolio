---
import Base from '../layouts/Base.astro';
import PageNav from '../components/PageNav.astro';
import { site } from '../site.config';
import { cv } from '../cv.config';
import { withBase } from '../lib/base';

const summaryParagraphs = cv.summary.split(/\n{2,}/).filter(Boolean);

function contactPrintText(href: string): string {
  return href.startsWith('mailto:') ? href.slice('mailto:'.length) : href;
}

const origin = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(withBase(path), origin).toString();
const pageUrl = new URL(Astro.url.pathname, origin).toString();
const personId = `${abs('/')}#person`;
const websiteId = `${abs('/')}#website`;

const languageGroup = cv.skills.find((g) => /languages/i.test(g.label));
const knowsLanguage = languageGroup?.items.map((item) => item.replace(/\s*\(.*\)\s*$/, '').trim());
const topSkills = cv.skills.find((g) => /skills/i.test(g.label))?.items ?? [];

// Enrich the shared Person node (merged by @id) with CV facts, and describe the
// page itself as a ProfilePage.
const jsonLd = [
  {
    '@type': 'Person',
    '@id': personId,
    ...(cv.experience[0]?.org
      ? { worksFor: { '@type': 'Organization', name: cv.experience[0].org } }
      : {}),
    alumniOf: cv.education
      .filter((e) => e.org)
      .map((e) => ({ '@type': 'EducationalOrganization', name: e.org })),
    ...(cv.contact?.location
      ? { address: { '@type': 'PostalAddress', addressLocality: cv.contact.location } }
      : {}),
    ...(knowsLanguage?.length ? { knowsLanguage } : {}),
    ...(topSkills.length ? { knowsAbout: topSkills } : {}),
  },
  {
    '@type': 'ProfilePage',
    '@id': `${pageUrl}#profilepage`,
    url: pageUrl,
    name: `About / CV — ${cv.name ?? site.name}`,
    isPartOf: { '@id': websiteId },
    mainEntity: { '@id': personId },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Map', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'About / CV', item: pageUrl },
    ],
  },
];
---

<Base
  title="About / CV"
  description={`Curriculum vitae of ${cv.name ?? site.name}, ${cv.headline ?? site.role}.`}
  ogType="profile"
  jsonLd={jsonLd}
>
  <article class="cv container">
    <PageNav>
      <li>
        <a class="link" href={withBase('/')}>Back to map</a>
      </li>
      <button slot="at-rest" class="link js-download-pdf" type="button">Download PDF</button>
    </PageNav>

    <header class="cv__head" data-reveal>
      <div class="cv__id">
        <h1 class="cv__name">{cv.name ?? site.name}</h1>
        <p class="cv__role">{cv.headline ?? site.role}</p>
        <div class="cv__contact-print print-only">
          {site.socials.map((s) => (
            <p>{contactPrintText(s.href)}</p>
          ))}
        </div>
      </div>

      <div class="cv__actions no-print">
        <ul role="list" class="cv__contact link-row">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} class="link">{s.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <div class="cv__summary" data-reveal style="--reveal-delay: 80ms;">
      {summaryParagraphs.map((para) => <p>{para}</p>)}
    </div>

    <section class="cv__section" data-reveal style="--reveal-delay: 140ms;">
      <h2 class="cv__section-title">Experience</h2>
      <div class="cv__list">
        {
          cv.experience.map((job) => (
            <div class="entry">
              <div class="entry__period">{job.period}</div>
              <div class="entry__main">
                <h3 class="entry__role">
                  {job.role}, {job.org}
                </h3>
                {/* {job.location && <p class="entry__loc mono">{job.location}</p>} */}
                {job.summary && <p class="entry__summary">{job.summary}</p>}
                <ul role="list" class="entry__points">
                  {job.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="cv__section" data-reveal>
      <h2 class="cv__section-title">Education</h2>
      <div class="cv__list">
        {
          cv.education.map((e) => (
            <div class="entry">
              <div class="entry__period">{e.period}</div>
              <div class="entry__main">
                <h3 class="entry__role">{e.title}</h3>
                <p class="entry__org-line">{e.org}</p>
                {e.note && <p class="entry__summary">{e.note}</p>}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <div class="cv__foot no-print" data-reveal>
      <button class="link js-download-pdf" type="button">Download PDF</button>
    </div>
  </article>
</Base>

<style>
  .cv {
    max-width: var(--measure);
    padding-block: var(--space-lg);
  }

  .cv__foot {
    margin-block-start: var(--space-xl);
  }

  .cv__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .cv__name {
    margin-block-end: var(--space-sm);
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
  }

  .cv__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm) var(--space-md);
  }

  .cv__summary {
    margin-block-start: var(--space-lg);
  }

  .cv__summary p + p {
    margin-block-start: var(--space-md);
  }

  .cv__section {
    margin-block-start: var(--space-xl);
  }

  .cv__section-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    padding-block-end: var(--space-sm);
    margin-block-end: var(--space-lg);
    border-block-end: 1px solid var(--line-strong);
  }

  .cv__list {
    display: grid;
    gap: var(--space-lg);
  }

  .entry {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-lg);
  }

  @media (width <= 640px) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }

  .entry__period {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    color: var(--ink-3);
    padding-block-start: 0.4375rem;
    text-wrap: balance;
  }

  .entry__role {
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
  }

  .entry__points {
    margin-block-start: var(--space-sm);
    display: grid;
    gap: var(--space-sm);
    list-style: square;
  }

  .entry__points li::marker {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .print-only {
    display: none;
  }

  @media print {
    .cv {
      max-width: none;
      font-size: 12pt;
    }

    .container {
      padding: 0;
    }

    .cv__contact-print {
      display: block;
      font-size: 12pt;
      padding-block: 5mm;
      margin-block-start: 5mm;
      border-block-start: 1px solid #000;
      border-block-end: 1px solid #000;
    }

    .cv__summary {
      margin-block-start: 5mm;
    }

    .cv__section,
    .cv__list {
      break-inside: auto;
    }

    .cv__list {
      display: block;
    }

    .cv__list .entry + .entry {
      margin-block-start: var(--space-lg);
    }

    .entry {
      display: block;
      break-inside: auto;
    }

    .entry__period {
      margin-block-end: 0.25em;
    }

    .entry__main {
      break-inside: auto;
    }

    .entry__points {
      display: block;
      break-inside: auto;
      padding-inline-start: 1em;
    }

    .entry__points li + li {
      margin-block-start: var(--space-sm);
    }

    .entry__points li {
      break-inside: avoid;
    }

    .entry__points li::marker {
      color: #000;
    }
  }
</style>
