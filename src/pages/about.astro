---
/** About / CV. Content comes from `src/cv.data.json` — regenerate it with
    `npm run sync:linkedin`; everything about how it looks is in this file. */

import Base from '../layouts/Base.astro';
import PageNav from '../components/PageNav.astro';
import { site } from '../site.config';
import { withBase } from '../lib/base';
import cvData from '../cv.data.json';

interface CV {
  name?: string;
  headline?: string;
  summary: string;
  experience: { role: string; org: string; period: string; summary?: string; points: string[] }[];
  education: { title: string; org?: string; period?: string; note?: string }[];
  skills: { label: string; items: string[] }[];
  contact?: { location?: string };
}

const cv = cvData as CV;
const name = cv.name ?? site.name;
const headline = cv.headline ?? site.role;
const summary = cv.summary.split(/\n{2,}/).filter(Boolean);

const origin = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(withBase(path), origin).toString();
const pageUrl = new URL(Astro.url.pathname, origin).toString();
const personId = `${abs('/')}#person`;

const languages = cv.skills
  .find((g) => /languages/i.test(g.label))
  ?.items.map((item) => item.replace(/\s*\(.*\)\s*$/, '').trim());
const topSkills = cv.skills.find((g) => /skills/i.test(g.label))?.items ?? [];

// Enrich the shared Person node (merged by @id) with CV facts, and describe the
// page itself as a ProfilePage.
const jsonLd = [
  {
    '@type': 'Person',
    '@id': personId,
    ...(cv.experience[0]?.org
      ? { worksFor: { '@type': 'Organization', name: cv.experience[0].org } }
      : {}),
    alumniOf: cv.education
      .filter((e) => e.org)
      .map((e) => ({ '@type': 'EducationalOrganization', name: e.org })),
    ...(cv.contact?.location
      ? { address: { '@type': 'PostalAddress', addressLocality: cv.contact.location } }
      : {}),
    ...(languages?.length ? { knowsLanguage: languages } : {}),
    ...(topSkills.length ? { knowsAbout: topSkills } : {}),
  },
  {
    '@type': 'ProfilePage',
    '@id': `${pageUrl}#profilepage`,
    url: pageUrl,
    name: `About / CV — ${name}`,
    isPartOf: { '@id': `${abs('/')}#website` },
    mainEntity: { '@id': personId },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Map', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'About / CV', item: pageUrl },
    ],
  },
];
---

<Base
  title="About / CV"
  description={`Curriculum vitae of ${name}, ${headline}.`}
  ogType="profile"
  jsonLd={jsonLd}
>
  <article>
    <PageNav>
      <li><a href={withBase('/')}>Back to map</a></li>
      <button slot="at-rest" class="link" type="button" data-print>Download PDF</button>
    </PageNav>

    <header data-reveal>
      <div>
        <h1>{name}</h1>
        <p>{headline}</p>
        {/* On paper there are no links to click, so the addresses are spelled out. */}
        <div class="print-only">
          {site.socials.map((s) => <p>{s.href.replace(/^mailto:/, '')}</p>)}
        </div>
      </div>

      <ul class="no-print" role="list">
        {site.socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </header>

    <div class="summary" data-reveal style="--reveal-step: 1">
      {summary.map((para) => <p>{para}</p>)}
    </div>

    <section data-reveal style="--reveal-step: 2">
      <h2>Experience</h2>
      {
        cv.experience.map((job) => (
          <div class="entry">
            <p class="period">{job.period}</p>
            <div>
              <h3>{job.role}, {job.org}</h3>
              {job.summary && <p>{job.summary}</p>}
              <ul>
                {job.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section data-reveal>
      <h2>Education</h2>
      {
        cv.education.map((entry) => (
          <div class="entry">
            <p class="period">{entry.period}</p>
            <div>
              <h3>{entry.title}</h3>
              <p>{entry.org}</p>
              {entry.note && <p>{entry.note}</p>}
            </div>
          </div>
        ))
      }
    </section>

    <div class="download no-print" data-reveal>
      <button class="link" type="button" data-print>Download PDF</button>
    </div>
  </article>
</Base>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  h1 {
    margin-block-end: var(--space-sm);
  }

  .summary {
    margin-block-start: var(--space-lg);
  }

  .summary p + p {
    margin-block-start: var(--space-md);
  }

  section {
    margin-block-start: var(--space-xl);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    padding-block-end: var(--space-sm);
    margin-block-end: var(--space-lg);
    border-block-end: 1px solid var(--line-strong);
  }

  /* Dates in a fixed column, the job beside them. */

  .entry {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-lg);
  }

  .entry + .entry {
    margin-block-start: var(--space-lg);
  }

  @media (width <= 640px) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    color: var(--ink-3);
    padding-block-start: 0.4375rem;
    text-wrap: balance;
  }

  .entry ul {
    margin-block-start: var(--space-sm);
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: square;
  }

  .entry li::marker {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .download {
    margin-block-start: var(--space-xl);
  }

  /* This page is the CV, so it has to fall onto A4 cleanly: no column limit, a
     printable contact block, and page breaks that never split a bullet. */

  @media print {
    article {
      font-size: 12pt;
    }

    .print-only {
      font-size: 12pt;
      padding-block: 5mm;
      margin-block-start: 5mm;
      border-block: 1px solid #000;
    }

    .summary {
      margin-block-start: 5mm;
    }

    section,
    .entry,
    .entry > div,
    .entry ul {
      break-inside: auto;
    }

    .entry {
      display: block;
    }

    .period {
      margin-block-end: 0.25em;
    }

    .entry ul {
      display: block;
      padding-inline-start: 1em;
    }

    .entry li {
      break-inside: avoid;
    }

    .entry li + li {
      margin-block-start: var(--space-sm);
    }

    .entry li::marker {
      color: #000;
    }
  }
</style>
