---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
---

<Base
  title="Page not found"
  description="The page you were looking for doesn't exist or has moved."
>
  <section>
    <h1 class="meta" data-reveal>Page not found</h1>
    <h2 data-reveal style="--reveal-step: 1">You've wandered off the map</h2>
    <p data-reveal style="--reveal-step: 2">
      The page you were looking for doesn't exist, or it has moved. Head back to the map and pick another page to continue.
    </p>
    <ul role="list" data-reveal style="--reveal-step: 3">
      <li><a href={withBase('/')}>Back to map</a></li>
    </ul>
  </section>
</Base>

<style>
  /* Short page: hold it near the middle of the viewport rather than the top. */

  section {
    min-height: 50svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h2 {
    margin-block: var(--space-sm);
  }

  ul {
    margin-block-start: var(--space-md);
  }
</style>
