---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { getProjects, projectYear } from '../../lib/projects';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const year = projectYear(entry);
const byline = [data.role, data.client].filter(Boolean).join(', ');
---

<Base title={data.title} description={data.description}>
  <article class="project container">
    <ul class="project__nav link-row" role="list">
      <li>
        <a class="link" href={withBase('/')}>Back to map</a>
      </li>
    </ul>

    <header class="project__head" data-reveal>
      <h1 class="project__title">{data.title}</h1>
      {byline && <p class="project__byline">{byline}</p>}
      <p class="project__year">{year}</p>
      <div class="project__summary">
        <p>{data.description}</p>
      </div>
      {
        data.tags.length > 0 && (
          <p class="project__tags">{data.tags.join(' · ')}</p>
        )
      }
      {
        data.links.length > 0 && (
          <ul class="project__links link-row" role="list">
            {data.links.map((l) => (
              <li>
                <a class="link" href={l.href} rel="noopener" target="_blank">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="project__body prose" data-reveal style="

--reveal-delay:80ms;">
      <Content />
    </div>

    {data.locked && <PasswordGate slug={entry.id} />}

    <ul class="project__nav project__nav--foot link-row" role="list">
      <li>
        <a class="link" href={withBase('/')}>Back to map</a>
      </li>
    </ul>
  </article>
</Base>

<style>
  .project {
    max-width: var(--measure);
    padding-block: var(--space-lg);
  }

  .project__nav {
    margin-block-end: var(--space-lg);
  }

  .project__nav--foot {
    margin-block: calc(var(--space-lg) * 3) 0;
  }

  .project__title {
    margin-block-end: var(--space-sm);
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
  }

  .project__byline {
    color: var(--ink-2);
  }

  .project__year {
    margin-block-start: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    color: var(--ink-3);
  }

  .project__summary {
    margin-block-start: var(--space-lg);
  }

  .project__tags {
    margin-block-start: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .project__links {
    margin-block-start: var(--space-md);
  }

  .project__body {
    margin-block-start: var(--space-xl);
  }

  .project__body :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    padding-block-end: var(--space-sm);
    margin-block: var(--space-xl) var(--space-lg);
    border-block-end: 1px solid var(--line-strong);
  }

  .project__body :global(> *:first-child) {
    margin-block-start: 0;
  }

  .project__body :global(h2:first-child) {
    margin-block-start: 0;
  }

  .project__body :global(ul) {
    display: grid;
    gap: var(--space-sm);
    list-style: square;
    padding-inline-start: 1.25em;
  }

  .project__body :global(ul li::marker) {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .project__body :global(p + p) {
    margin-block-start: var(--space-md);
  }
</style>
