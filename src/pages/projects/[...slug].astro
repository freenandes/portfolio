---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import RegMark from '../../components/RegMark.astro';
import { getProjects, projectYear } from '../../lib/projects';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i + 1 },
  }));
}

const { entry, index } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const year = projectYear(entry);
const dateLabel = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<Base title={data.title} description={data.description}>
  <article class="project container">
    <a class="back mono" href={withBase('/')}>← Index</a>

    <header class="project__head">
      <p class="label project__num">
        <RegMark size={12} /> Project / {String(index).padStart(2, '0')}
      </p>
      <h1 class="project__title">{data.title}</h1>
      <p class="project__desc">{data.description}</p>

      <dl class="project__meta">
        {data.role && (
          <div><dt class="label">Role</dt><dd>{data.role}</dd></div>
        )}
        {data.client && (
          <div><dt class="label">Client</dt><dd>{data.client}</dd></div>
        )}
        <div><dt class="label">Year</dt><dd>{year}</dd></div>
        {data.tags.length > 0 && (
          <div class="project__meta-tags">
            <dt class="label">Stack</dt>
            <dd>{data.tags.join(' · ')}</dd>
          </div>
        )}
      </dl>

      {
        data.links.length > 0 && (
          <p class="project__links">
            {data.links.map((l) => (
              <a class="project__link" href={l.href} rel="noopener" target="_blank">
                {l.label} ↗
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="project__cover">
      <Cover
        title={data.title}
        accent={data.accent}
        index={index}
        cover={data.cover}
        coverAlt={data.coverAlt}
        locked={data.locked}
        ratio="16 / 9"
      />
      <p class="mono project__caption">{dateLabel} — {data.accent.toUpperCase()} ®</p>
    </div>

    <div class="project__body prose">
      <Content />
    </div>

    {data.locked && <PasswordGate slug={entry.id} />}
  </article>
</Base>

<style>
  .project {
    padding-block: var(--space-xl);
    max-width: 56rem;
  }

  .back {
    display: inline-block;
    color: var(--ink-2);
    margin-block-end: var(--space-l);
    transition: color var(--dur-fast) var(--ease);
  }
  .back:hover {
    color: var(--ink);
  }

  .project__num {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    color: var(--ink-2);
  }

  .project__title {
    margin-block-start: var(--space-s);
    font-size: var(--step-4);
  }

  .project__desc {
    margin-block-start: var(--space-s);
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    margin-block-start: var(--space-l);
    padding-block: var(--space-m);
    border-block: 1px solid var(--line);
  }
  .project__meta dt {
    margin-block-end: 0.2rem;
  }
  .project__meta dd {
    font-size: var(--step-0);
  }
  .project__meta-tags dd {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
  }
  .project__link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.9rem;
    transition: border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .project__link:hover {
    border-color: var(--ink);
    color: var(--accent-ink);
  }

  .project__cover {
    margin-block-start: var(--space-xl);
  }
  .project__caption {
    margin-block-start: var(--space-2xs);
    color: var(--ink-3);
    text-align: right;
  }

  .project__body {
    margin-block-start: var(--space-xl);
    font-size: var(--step-1);
  }
</style>
