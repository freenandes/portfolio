---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageNav from '../../components/PageNav.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { getProjects, projectYear } from '../../lib/projects';
import { withBase } from '../../lib/base';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const year = projectYear(entry);
const client = data.client && data.client !== data.title ? data.client : undefined;
const heading = client ? `${data.title} at ${client}` : data.title;

const origin = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(withBase(path), origin).toString();
const pageUrl = new URL(Astro.url.pathname, origin).toString();
const personId = `${abs('/')}#person`;
const websiteId = `${abs('/')}#website`;

const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    name: data.title,
    headline: data.title,
    description: data.description,
    url: pageUrl,
    datePublished: data.date.toISOString(),
    inLanguage: site.locale,
    isPartOf: { '@id': websiteId },
    author: { '@id': personId },
    creator: { '@id': personId },
    ...(data.tags.length ? { keywords: data.tags.join(', ') } : {}),
    ...(data.client ? { sourceOrganization: { '@type': 'Organization', name: data.client } } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Map', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: data.title, item: pageUrl },
    ],
  },
];
---

<Base title={data.title} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article class="project container">
    <PageNav>
      <li>
        <a class="link" href={withBase('/')}>Back to map</a>
      </li>
    </PageNav>

    <header class="project__head" data-reveal>
      <h1 class="project__title">{heading}</h1>
      <p>{data.description}</p>
      <div class="project__summary">
        <ul class="project__meta meta-row" role="list">
          {data.role && <li class="meta">{data.role}</li>}
          <li class="meta"><time datetime={data.date.toISOString()}>{year}</time></li>
          {data.tags.map((t) => <li class="meta">{t}</li>)}
        </ul>
      </div>
    </header>

    <div class="project__body prose" data-reveal style="

--reveal-delay:80ms;">
      <Content />
    </div>

    {data.locked && <PasswordGate slug={entry.id} />}

    {
      data.links.length > 0 && (
        <ul class="project__links link-row" role="list">
          {data.links.map((l) => (
            <li>
              <a class="link" href={l.href} rel="noopener" target="_blank">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</Base>

<style>
  .project {
    max-width: var(--measure);
    padding-block: var(--space-lg);
  }

  .project__title {
    margin-block-end: var(--space-sm);
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
  }

  .project__summary {
    margin: var(--space-lg) 0;
  }

  .project__links {
    margin-block-start: var(--space-xl);
  }

</style>
