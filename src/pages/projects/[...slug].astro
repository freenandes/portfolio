---
/** A case study. Body copy lives in `src/content/projects/<slug>.mdx`; locked
    projects add the passphrase gate below the public teaser. */

import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageNav from '../../components/PageNav.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { getProjects, projectYear } from '../../lib/projects';
import { withBase } from '../../lib/base';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const client = data.client && data.client !== data.title ? data.client : undefined;
const heading = client ? `${data.title} at ${client}` : data.title;

const origin = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(withBase(path), origin).toString();
const pageUrl = new URL(Astro.url.pathname, origin).toString();
const personId = `${abs('/')}#person`;

const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    name: data.title,
    headline: data.title,
    description: data.description,
    url: pageUrl,
    datePublished: data.date.toISOString(),
    inLanguage: site.locale,
    isPartOf: { '@id': `${abs('/')}#website` },
    author: { '@id': personId },
    creator: { '@id': personId },
    ...(data.tags.length ? { keywords: data.tags.join(', ') } : {}),
    ...(data.client ? { sourceOrganization: { '@type': 'Organization', name: data.client } } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Map', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: data.title, item: pageUrl },
    ],
  },
];
---

<Base title={data.title} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article>
    <PageNav>
      <li><a href={withBase('/')}>Back to map</a></li>
    </PageNav>

    <header data-reveal>
      <h1>{heading}</h1>
      <p>{data.description}</p>
      <ul class="meta-row" role="list">
        {data.role && <li class="meta">{data.role}</li>}
        <li class="meta"><time datetime={data.date.toISOString()}>{projectYear(entry)}</time></li>
        {data.tags.map((tag) => <li class="meta">{tag}</li>)}
      </ul>
    </header>

    <div class="prose" data-reveal style="--reveal-step: 1">
      <Content />
    </div>

    {data.locked && <PasswordGate slug={entry.id} />}

    {
      data.links.length > 0 && (
        <ul role="list" data-reveal style="--reveal-step: 3">
          {data.links.map((link) => (
            <li>
              <a href={link.href} rel="noopener" target="_blank">{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</Base>

<style>
  h1 {
    margin-block-end: var(--space-sm);
  }

  header ul {
    margin-block: var(--space-lg);
  }

  article > ul {
    margin-block-start: var(--space-xl);
  }
</style>
