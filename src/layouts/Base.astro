---
import '../styles/global.css';
import { site } from '../site.config';
import { withBase } from '../lib/base';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Hide background wash (e.g. print-focused pages). */
  bare?: boolean;
  mainClass?: string;
  /** Off on the diagram home — the map is the navigation. */
  footer?: boolean;
}

const {
  title,
  description = site.description,
  bare = false,
  mainClass,
  footer = true,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = new URL(withBase(site.ogImage), Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f2efe7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130f" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={withBase(site.favicon)} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {!bare && <div class="wash" aria-hidden="true"></div>}
    <div class="grid-overlay" aria-hidden="true"></div>

    <main id="main" class:list={[mainClass]}>
      <slot />
    </main>

    {footer && <Footer />}

    <script>
      document.documentElement.classList.add('is-ready');
    </script>
  </body>
</html>
