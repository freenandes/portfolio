---
import '../styles/global.css';
import { site } from '../site.config';
import { withBase } from '../lib/base';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Hide the soft gradient wash (e.g. for print-heavy pages). */
  bare?: boolean;
  /** Adds a class to <main> for page-specific tweaks. */
  mainClass?: string;
}

const {
  title,
  description = site.description,
  bare = false,
  mainClass,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = new URL(withBase(site.ogImage), Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f2efe7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130f" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {!bare && <div class="wash" aria-hidden="true"></div>}
    <div class="grid-overlay" aria-hidden="true"></div>

    <Header />

    <main id="main" class:list={[mainClass]}>
      <slot />
    </main>

    <Footer />

    <script>
      // Progressive enhancement: enable reveal animations only with JS on.
      document.documentElement.classList.add('is-ready');
    </script>

    <style is:global>
      /* Soft-club wash: a low, blurred pastel light behind everything. */
      .wash {
        position: fixed;
        inset: -20vmax -10vmax auto -10vmax;
        height: 80vmax;
        background: var(--wash);
        filter: blur(40px) saturate(1.1);
        opacity: 0.5;
        z-index: -2;
        pointer-events: none;
      }

      /* TDR-ish faint engineering grid. */
      .grid-overlay {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image: linear-gradient(
            to right,
            color-mix(in oklab, var(--line) 55%, transparent) 1px,
            transparent 1px
          ),
          linear-gradient(
            to bottom,
            color-mix(in oklab, var(--line) 55%, transparent) 1px,
            transparent 1px
          );
        background-size: clamp(48px, 8vw, 96px) clamp(48px, 8vw, 96px);
        opacity: 0.35;
        -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 80%);
        mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 80%);
      }

      main {
        position: relative;
        z-index: var(--z-base);
      }
    </style>
  </body>
</html>
