---
/** The shell every page renders into: <head>, skip link, <main>, footer. */

import '../styles/global.css';
import { site } from '../site.config';
import { withBase } from '../lib/base';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Class on <main>. Only the home page uses one, to go full-bleed. */
  mainClass?: string;
  /** Off on the diagram home — the map is the navigation. */
  footer?: boolean;
  /** Open Graph type for this page (e.g. "website", "profile", "article"). */
  ogType?: string;
  /** Extra schema.org nodes appended to the page's JSON-LD @graph. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  mainClass,
  footer = true,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).toString();
const siteBase = new URL(withBase('/'), origin).toString();
const ogImage = new URL(withBase(site.ogImage), origin).toString();
const topoPattern = mainClass === 'home' ? withBase('/topo-low.svg') : null;

// Profiles the site owner can be cross-referenced by (schema.org sameAs).
const sameAs = site.socials
  .filter((s) => /^https?:/.test(s.href))
  .map((s) => s.href);

// Site-wide JSON-LD. Page-specific nodes (ProfilePage, CreativeWork,
// BreadcrumbList…) are appended via the `jsonLd` prop and share these @ids.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteBase}#website`,
      url: siteBase,
      name: site.name,
      description: site.description,
      inLanguage: site.locale,
      publisher: { '@id': `${siteBase}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteBase}#person`,
      name: site.name,
      jobTitle: site.role,
      description: site.description,
      url: siteBase,
      image: ogImage,
      ...(sameAs.length ? { sameAs } : {}),
    },
    ...jsonLd,
  ],
};

// Static-site CSP delivered via <meta>. Note: frame-ancestors, sandbox and
// report-uri are header-only and are intentionally omitted here (see
// SPEC-COMPLIANCE.md). 'unsafe-inline' is required for style only because the
// theme relies on inline `style="--…"` custom-property attributes; scripts are
// all bundled to files (see the assetsInlineLimit note in astro.config.mjs), so
// script-src needs nothing but 'self'.
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data:",
  "connect-src 'self'",
  "form-action 'self'",
  "manifest-src 'self'",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:ital,wght@0,200..800;1,200..800&family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&display=swap"
    />

    <link rel="icon" href={withBase(site.favicon)} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <noscript>
      <style>
        /* Entrance motion is a progressive enhancement. Without scripting the
           page is served as-is: nothing waits to be revealed. */
        [data-reveal] {
          animation: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main
      id="main"
      class:list={[mainClass]}
      style={topoPattern ? `--topo-pattern: url('${topoPattern}')` : undefined}
    >
      <slot />
    </main>

    {footer && <Footer />}

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  /* Parked off-canvas with a transform rather than `top` so revealing it is a
     compositor-only move. Resets the site's link look: this is a control. */

  .skip-link {
    position: absolute;
    left: var(--space-sm);
    top: var(--space-sm);
    z-index: var(--z-overlay);
    font: inherit;
    letter-spacing: normal;
    text-transform: none;
    text-decoration: none;
    text-underline-offset: auto;
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    transform: translateY(calc(-100% - var(--space-md)));
    transition: transform var(--dur) var(--ease);
  }

  .skip-link:focus {
    transform: none;
  }

  @media print {
    .skip-link {
      display: none !important;
    }
  }
</style>
